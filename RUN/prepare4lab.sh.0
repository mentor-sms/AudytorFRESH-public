#!/bin/bash
# -*- coding: utf-8 -*-

# installer4lab STEP 0 //prepare4lab.sh.0
WERSJA=4.2.0
# WERSJA nie moze byc zadeklarowana ponizej 10 linii skryptu!

MIC_TYPE=0 # 1 dla dynamicznego
DEBUG_LEVEL=2
# 0 - debug, sieczka
# 1 - informacyjnie, nie dla klienta
# 2 - ostrzezenia, domyslne
# 3 - bledy
# 4 - bledy krytyczne
# 5 - bledy kryczyne i komunikacja szeregowa
# 6 - bledy krytyczne i komunikacja LAN

# Error categories (0-255):
# 1-9:   Configuration errors
# 10-19: User input errors
# 20-39: File system errors
# 40-59: Network errors
# 60-79: Permission errors
# 80-99: Resource errors
# 100-129: System command errors
# 130-149: Package management errors
# 150-179: Device errors
# 180-199: Service errors
# 200-229: Script execution errors
# 230-255: Miscellaneous/unexpected errors

HOST=0.0.0.0
PORT=0
# installer4lab vars
# HOST, PORT, VER_PC

# todo - automate via installer4lab:
VER_APP="$WERSJA"
VER_LIB="$WERSJA"

prep=0 # runs preinstall.sh
user=0 # runs preinstall.sh, apt full-upgrade
dbg=0 # waits for [Enter] often
devel=0
clear=1 # clears step file before beginning by default
job="" # arg0 for step 1+
quick=0
args_string="" # additional arguments as string
step=666

show_help() {
  cat << EOF
╔══════════════════════════════════════════════════════════════════════════════
║ prepare4lab.sh v$WERSJA - Mentor Lab Preparation Utility
╠══════════════════════════════════════════════════════════════════════════════
║ Usage: sudo $0 [job] [options]
║
║ Job Type (required):
║   release              Configure system for release environment
║   devel                Configure system for development environment
║
║ Main Options:
║   --user               Run in user mode (perform system upgrades)
║   --debug              Run in debug mode (more verbose output)
║   --continue           Continue from last step (don't clear state)
║   --quick              Skip confirmation prompts
║
║ Error Categories:
║   1-9:     Configuration errors
║   10-19:   User input errors
║   20-39:   File system errors
║   40-59:   Network errors
║   60-79:   Permission errors
║   80-99:   Resource errors
║   100-129: System command errors
║   130-149: Package management errors
║   150-179: Device errors
║   180-199: Service errors
║   200-229: Script execution errors
║   230-255: Miscellaneous/unexpected errors
║
║ Examples:
║   sudo $0 release --user --debug
║   sudo $0 devel --continue --quick
╚══════════════════════════════════════════════════════════════════════════════
EOF
}

# Check for help option first
if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  show_help
  exit 0
fi

# Usage: command || report_error errno "message"
echo_error() {
  local status=$?        # Capture exit status of previous command
  local errno="$1"       # Error number/code
  local message="$2"     # Error message text
  local cmd_status="${3:-$status}"  # Use provided status or captured status
  
  # Ensure errno is a valid number
  if ! [[ "$errno" =~ ^[0-9]+$ ]]; then
    echo "Invalid error number: $errno. Using 255 instead."
    errno=255
  fi
  
  # Include command status if available
  if [ -n "$cmd_status" ]; then
    echo "[err$errno] $message [status=$cmd_status]"
  else
    echo "[err$errno] $message"
  fi
  
  # Interactive mode for user
  if [ "$user" -eq 1 ] && [ $quick -eq 0 ]; then
    echo "[Enter] to continue, Ctrl+C to cancel..."
    read -r
  fi
  
  # Return the errno as exit code (ensuring it's in valid range 0-255)
  exit $(( errno % 256 ))
}

if [ $# -gt 0 ]; then
  # First argument is the job type (release or devel)
  job="$1"
  shift

  # Store original arguments for later use
  original_args=("$job")

  # Process job type first
  if [ "$job" = "release" ]; then
    true
  elif [ "$job" = "devel" ]; then
    devel=1
  else
    echo_error 10 "Invalid job: $job"
  fi

  # Process remaining arguments
  continue_flag=0
  while [ $# -gt 0 ]; do
    original_args+=("$1")
    case "$1" in
      --user)
        user=1
        clear=1 # reinstall when --user is specified
        ;;
      --debug)
        dbg=1
        ;;
      --continue)
        continue_flag=1
        ;;
      --quick)
        quick=1
        ;;
      *)
        ;;
    esac
    shift
  done
  
  if [ "$continue_flag" -eq 1 ]; then
    clear=0 # don't clear step file
  fi
  # Build the arguments string for later use
  args_string=""
  for arg in "${original_args[@]:1}"; do
    args_string="$args_string $arg"
  done
else
  echo_error 10 "Missing required arguments. Please specify 'release' or 'devel' and optional flags: --user --debug --continue --quick. Use --help for more information."
fi

echo_info() {
  local msg="$1"
  local cmd_status="$2"

  # If command status is provided, include it in the output
  if [ -n "$cmd_status" ]; then
    msg="$msg [status=$cmd_status]"
  fi

  # Interactive mode with debug
  if [ $dbg -eq 1 ] && [ "$user" -eq 1 ] && [ $quick -eq 0 ]; then
    echo "$msg //Enter..."
    read -r
  else
    echo "$msg"
  fi

  # Sleep in debug mode for better readability
  if [ $dbg -eq 1 ] && [ $quick -eq 0 ]; then
    sleep 1
  fi
}

echo_stop() {
  local operation="$1"
  local details="$2"

  # Print operation with details if provided
  if [ -n "$details" ]; then
    echo "CRITICAL OPERATION: $operation [$details]"
  else
    echo "CRITICAL OPERATION: $operation"
  fi

  # Always flush disk buffers before critical operations
  sync

  # Interactive mode for user
  if [ "$user" -eq 1 ] && [ $quick -eq 0 ]; then
    echo "[Enter] to continue, Ctrl+C to cancel..."
    read -r
  elif [ $dbg -eq 1 ] && [ $quick -eq 0 ]; then
    # In debug mode without user interaction, still pause briefly
    echo "Ctrl+C to cancel. 3, 2, 1..."
    sleep 5
  fi
}

echo_wait() {
  local message="$1"
  echo_info "WAIT: $message"
  if [ "$user" -eq 1 ] && [ "$quick" -eq 0 ]; then
    echo "Press [Enter] to continue, or wait 5 seconds..."
    read -t 5 -r || echo_info "Timeout waiting for user input, continuing"
  elif [ "$dbg" -eq 1 ]; then
    sleep 2
  fi
  return 0
}

rere() {
  echo_wait "Ponowne uruchomienie systemu..."
  
  # Ensure all data is written to disk
  sync || true

  # Try multiple methods of system reboot based on verbosity and interactivity settings

  # Most verbose with user interaction
  if [ "$dbg" -eq 1 ] && [ "$user" -eq 1 ]; then
    echo "Rebooting with verbose output and interaction allowed..."
    shutdown -r now || systemctl reboot || reboot || echo_error 1 "Reboot command failed"
  # Verbose but non-interactive
  elif [ "$dbg" -eq 1 ] && [ "$user" -eq 0 ]; then
    echo "Rebooting with verbose output but non-interactive..."
    shutdown -r -f now || systemctl reboot || reboot || echo_error 1 "Reboot command failed"
  # Least verbose, still with interaction if needed
  elif [ "$dbg" -eq 0 ] && [ "$user" -eq 1 ]; then
    shutdown -r now >/dev/null || systemctl reboot >/dev/null || reboot >/dev/null || echo_error 1 "Reboot command failed"
  # Least verbose, no interaction (fails on interaction)
  else
    shutdown -r -f now >/dev/null 2>&1 || systemctl reboot >/dev/null 2>&1 || reboot >/dev/null 2>&1 || echo_error 1 "Reboot command failed"
  fi

  # Wait a moment for reboot to start
  sleep 5
  # If we get here, reboot failed
  
}

chown_chmod() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo_error 1 "chown_chmod requires two parameters: permissions and filename"
  fi
  
  if [ ! -e "$2" ]; then
    if [[ "$1" == *"7"* ]]; then  # If permission includes 7, likely a directory
      mkdir -p "$2" || echo_error 1 "Failed to create directory $2"
    else
      touch "$2" || echo_error 1 "Failed to create file $2"
    fi
  fi
  
  # Check if pi user exists
  if ! id pi &>/dev/null; then
    echo_error 1 "User 'pi' does not exist"
  fi
  
  # Set ownership
  chown pi:pi "$2" || echo_error 1 "Failed to change ownership of $2"
  
  # Validate permissions format
  if ! [[ "$1" =~ ^[0-7]{3}$ ]]; then
    echo_error 1 "Invalid permissions format: $1"
    
  fi
  
  # Set permissions
  chmod "$1" "$2" || echo_error 1 "Failed to change permissions of $2"
  
  # Verify changes
  local owner
  owner=$(stat -c "%U:%G" "$2")
  if [ "$owner" != "pi:pi" ]; then
    echo_error 1 "Ownership verification failed for $2. Expected pi:pi, got $owner"
    
  fi
  
  local perms
  perms=$(stat -c "%a" "$2")
  if [ "$perms" != "$1" ]; then
    echo_error 1 "Permission verification failed for $2. Expected $1, got $perms"
    
  fi
  
  return 0
}

wait_apt() {
  # Maximum wait time in seconds
  local max_wait
  max_wait=300  # 5 minutes
  local start_time
  start_time=$(date +%s)
  local current_time
  local elapsed_time

  echo_info "Waiting for apt locks to be released (timeout: ${max_wait}s)"

  while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; do
    current_time=$(date +%s)
    elapsed_time=$((current_time - start_time))

    # Display progress every 10 seconds
    if [ $((elapsed_time % 10)) -eq 0 ]; then
      echo_info "Still waiting for apt locks (${elapsed_time}s elapsed)"
      fuser -v /var/lib/dpkg/lock-frontend 2>/dev/null || echo_info "No processes holding the lock but lock file still exists"
    fi

    # Check if we've waited too long
    if [ "$elapsed_time" -gt "$max_wait" ]; then
      echo_info "Maximum wait time (${max_wait}s) exceeded"

      # Check if the process holding the lock is still running
      pid=$(fuser /var/lib/dpkg/lock-frontend 2>/dev/null)
      if [ -n "$pid" ]; then
        echo_info "Process(es) $pid holding the lock"
        if ! ps -p "$pid" > /dev/null; then
          echo_info "Process $pid not running, attempting to remove stale lock files"
          rm -f /var/lib/dpkg/lock-frontend || { status=$?; echo_error 1 "Failed to remove stale lock-frontend file" "$status"; }
          rm -f /var/lib/dpkg/lock || echo_info "Could not remove dpkg lock file, continuing anyway" $?
          dpkg --configure -a || echo_info "dpkg --configure -a failed, continuing anyway" $?
          echo_info "Stale lock files handled"
          break
        else
          echo_error 1 "Process $pid still running after ${max_wait}s, cannot proceed with apt operations"
          
        fi
      else
        echo_error 1 "No process ID found but lock still exists after ${max_wait}s"
        
      fi
    fi
    sleep 1
  done

  echo_info "Apt locks released, proceeding with apt operations"
  return 0
}

set_step() {
  step=$1

  # Validate numeric step value
  if ! echo "$step" | grep -Eq '^[0-9]+$'; then
    echo_error 1 "Invalid step value, must be numeric"
  fi
  
  # Ensure home directory exists and is accessible
  if [ ! -d /home/pi ]; then
    echo_error 1 "/home/pi directory not found"
  fi
  
  # Remove existing step file with error handling
  if [ -f /home/pi/.prepare4lab.step ]; then
    rm -f /home/pi/.prepare4lab.step || echo_error 1 "Failed to remove /home/pi/.prepare4lab.step"
  fi
  
  # Write new step value with error handling
  echo "$step" | sudo -u pi tee /home/pi/.prepare4lab.step > /dev/null || echo_error 1 "Failed to write to /home/pi/.prepare4lab.step"
  
  # Verify written step value
  if [ ! -f /home/pi/.prepare4lab.step ]; then
    echo_error 1 "Step file was not created"
    
  fi
  
  read_step=$(<"/home/pi/.prepare4lab.step") || echo_error 1 "Failed to read /home/pi/.prepare4lab.step"
  
  if [ "$read_step" != "$step" ]; then
    echo_error 1 "Step value mismatch. Expected: $step, Got: $read_step"
    
  fi
}

# installer4lab embedded-scripts

# installer4lab generate_files()

create_files() {
    CMDLINE_FILE="/boot/firmware/cmdline.txt"
    
    # Extract the "root=PARTUUID=..." part from the cmdline.txt
    ROOT_PARTUUID=$(grep -o "root=PARTUUID=[^ ]*" "$CMDLINE_FILE") || {
        echo_error 1 "Could not find 'root=PARTUUID' in $CMDLINE_FILE."
    }
    
    if [ -z "$ROOT_PARTUUID" ]; then
        echo_error 1 "PARTUUID extraction failed."
    fi
    
    echo "Extracted root PARTUUID: $ROOT_PARTUUID"
    echo "Contents of $CMDLINE_FILE before modification:"
    cat "$CMDLINE_FILE"
    
    # installer4lab clear generate_files
    
    if grep -q "root=" "$CMDLINE_FILE"; then
        echo_error 1 "cmdline.txt still contains 'root=' after overriding."
    fi
    
    sed -i '${/^$/d;}' "$CMDLINE_FILE" || {
        echo_error 1 "Failed to remove trailing newline from $CMDLINE_FILE."
    }

    sed -i "\$s/\$/ ${ROOT_PARTUUID}/" "$CMDLINE_FILE" || {
        echo_error 1 "Failed to append PARTUUID to $CMDLINE_FILE."
    }
    
    sed -i -e '${/^$/d;}' -e 's/[[:space:]]*$//' "$CMDLINE_FILE" || {
        echo_error 1 "Failed to process $CMDLINE_FILE."
    }

    echo "Contents of $CMDLINE_FILE after modification:"
    cat "$CMDLINE_FILE"
}

new_profile() {
  # Backup existing profile if it exists
  if [ -f /home/pi/.profile ]; then
    cp /home/pi/.profile /home/pi/.profile.mentorbak || true
  fi

  # Copy skeleton profile
  cp -rf /etc/skel/.profile /home/pi/.profile || echo_error 1 "Failed to copy .profile"
  chown pi:pi /home/pi/.profile || echo_error 1 "Failed to change ownership of .profile"
  chmod 644 /home/pi/.profile || echo_error 1 "Failed to set permissions on .profile"
  
  # Check and ensure .mentor directory exists
  if [ ! -d /home/pi/.mentor ]; then
    echo_error 1 "/home/pi/.mentor directory does not exist"
    
  fi
  
  # Check for profile.sh
  if [ ! -f /home/pi/.mentor/profile.sh ]; then
    echo_error 1 "/home/pi/.mentor/profile.sh not found"
    
  fi
  
  # Check if profile.sh is readable
  if [ ! -r /home/pi/.mentor/profile.sh ]; then
    echo_info "/home/pi/.mentor/profile.sh is not readable"
    # Try to fix permissions
    chmod 644 /home/pi/.mentor/profile.sh || echo_error 1 "failed to make profile.sh readable"
  fi
  
  # Append profile.sh
  cat /home/pi/.mentor/profile.sh >> /home/pi/.profile || echo_error 1 "Failed to append contents of profile.sh"
  
  # Append job with arguments
  printf "\njob=%s %s\n" "$job" "${args_string} --continue" >> /home/pi/.profile || echo_error 1 "Failed to append job with arguments"
  
  # Check for prepare4lab.run
  if [ ! -f /home/pi/.mentor/prepare4lab.run ]; then
    echo_error 1 "/home/pi/.mentor/prepare4lab.run not found"
    
  fi
  
  # Check if prepare4lab.run is readable
  if [ ! -r /home/pi/.mentor/prepare4lab.run ]; then
    echo_info "/home/pi/.mentor/prepare4lab.run is not readable"
    # Try to fix permissions
    chmod 644 /home/pi/.mentor/prepare4lab.run || echo_error 1 "Error: failed to make prepare4lab.run readable"
  fi
  
  # Append prepare4lab.run
  cat /home/pi/.mentor/prepare4lab.run >> /home/pi/.profile || echo_error 1 "Failed to append contents of prepare4lab.run"
  
  # Convert line endings
  dos2unix /home/pi/.profile 2>/dev/null || { 
    echo "Warning: dos2unix failed, trying alternative method for line ending conversion"
    sed -i 's/\r$//' /home/pi/.profile || echo_error 1 "Failed to convert line endings in .profile"
  }
  
  echo "Profile setup completed successfully"
}

test_network() {
  echo_info "Testing network connectivity"

  # Check IP assignment with detailed error handling
  ip_address=$(hostname -I | awk '{print $1}') || echo_error 1 "Failed to get IP address" $?;
  echo_info "Current IP address: $ip_address"

  local ierr
  ierr=0
  if [ -z "$ip_address" ]; then
    echo_info "No IP address assigned"
    ierr=1
  fi

  # Test internet connectivity only if we have an IP
  if [ $ierr -eq 0 ]; then
    echo_info "Testing connection to www.mentorpolska.pl"
    if ping -c 3 -W 5 www.mentorpolska.pl >/dev/null 2>&1; then
      echo_info "Successfully connected to www.mentorpolska.pl"
    else
      echo_info "Failed to connect to www.mentorpolska.pl, trying google.com"
      # Try alternative site
      if ping -c 3 -W 5 google.com >/dev/null 2>&1; then
        echo_info "Successfully connected to google.com"
        ierr=0
      else
        echo_info "Failed to connect to google.com"
        ierr=1
      fi
    fi
  fi

  if [ $ierr -ne 0 ]; then
    echo_info "Network connectivity issues detected"
    # Check network interface status
    ip addr show || echo_info "Failed to get network interface status" $?

    if [ "$user" -ne 1 ]; then
      echo_stop "Reconfiguring network" "Will modify system network configuration"

      local dhcpcd_conf
      dhcpcd_conf=$(cat <<-EOF
# plik fallback
# See dhcpcd.conf(5) for details.

hostname
clientid
persistent
option rapid_commit
option domain_name_servers, domain_name, domain_search, host_name
option classless_static_routes
option interface_mtu
require dhcp_server_identifier
slaac private

# DHCP ON
auto lo
iface lo inet loopback
iface eth0 inet dhcp
EOF
      )

      # Backup existing config if it exists
      if [ -f /etc/dhcpcd.conf ]; then
        echo_info "Backing up existing dhcpcd.conf"
        cp /etc/dhcpcd.conf /etc/dhcpcd.conf.mentorbak || echo_error 1 "Failed to backup dhcpcd.conf" $?
      fi

      echo_info "Writing new dhcpcd.conf configuration"
      if ! echo "$dhcpcd_conf" > /etc/dhcpcd.conf; then
        echo_error 1 "Failed to write new dhcpcd.conf" 1
      fi

      echo_info "Network reconfigured, rebooting system"
      rere
    else
      echo_info "Network issues detected but not reconfiguring in user mode"
    fi
  else
    echo_info "Network connectivity test passed"
  fi

  return 0
}

main() {
  echo_info "Starting prepare4lab script version $WERSJA"

  # Check for environment variables overriding user and debug settings
  if [ -n "$USER_LEVEL" ]; then
    user=$USER_LEVEL
    echo_info "Using environment USER_LEVEL=$USER_LEVEL"
  fi

  if [ -n "$DEBUG_LEVEL" ]; then
    dbg=$DEBUG_LEVEL
    echo_info "Using environment DEBUG_LEVEL=$DEBUG_LEVEL"
  fi

  echo_info "Checking for apt locks"
  wait_apt || echo_info "Continuing despite wait_apt issues"

  if [ "$(id -u)" -ne 0 ]; then
    echo_error 1 "This script must be run as root"
  	
  fi

  directory_path=/home/pi/.mentor
  echo_info "Checking for mentor directory: $directory_path"

  if [ ! -d $directory_path ]; then
    echo_info "Creating mentor directory: $directory_path"
  	mkdir -p $directory_path || echo_error 1 "Failed to create $directory_path"
  fi

  # Handle step file based on clear flag
  if [ $clear -eq 1 ]; then
    echo_info "Clear flag is set, removing any existing step file"
    rm -fr /home/pi/.prepare4lab.step || echo_error 1 "Failed to remove .prepare4lab.step"
    set_step 0 || echo_error 1 "Failed to set initial step"
  else
    echo_info "Reading existing step file"
    # Check if step file exists
    if [ ! -f "/home/pi/.prepare4lab.step" ]; then
      echo_info "No existing step file, creating with step 0"
      set_step 0 || echo_error 1 "Failed to set initial step"
    else
      file_content=$(<"/home/pi/.prepare4lab.step") || echo_error 1 "Failed to read .prepare4lab.step"
      echo_info "Current step file contains: $file_content"

      if echo "$file_content" | grep -Eq '^[0-9]+$'; then
        echo_info "Valid step value found: $file_content"
        set_step "$file_content" || echo_error 1 "Failed to set step to $file_content"
      else
        echo_info "Invalid step value in file, resetting to 0"
        if [ "$user" -eq 1 ]; then
          set_step 0 || echo_error 1 "Failed to reset step to 0"
        else
          set_step 0 || echo_error 1 "Failed to reset step to 0"
        fi
      fi
    fi
  fi

  echo_info "Current step: $step"

  # Handle special step values
  if [ "$step" -ne 0 ]; then
    if [ "$step" -eq 5 ]; then
      echo_info "Final step reached"
      if [ "$user" -eq 1 ]; then
        echo_info "In user mode, resetting to step 0"
        set_step 0 || echo_error 1 "Failed to reset step to 0"
      else
        echo_info "Setup complete, exiting"
        return 0
      fi
    elif [ "$step" -eq 1 ] || [ "$step" -eq 2 ] || [ "$step" -eq 3 ] || [ "$step" -eq 4 ]; then
      echo_info "Valid step $step, continuing"
    else
      echo_info "Unknown step $step"
      if [ "$user" -eq 1 ]; then
        echo_info "In user mode, resetting to step 0"
        set_step 0 || echo_error 1 "Failed to reset step to 0"
      else
        echo_error 1 "Invalid step $step in non-user mode"
        
      fi
    fi
  fi

  if [ "$prep" -eq 1 ]; then
    echo_info "Prep flag set, forcing step 0"
    step=0
  fi

  # Execute step function based on current step
  echo_info "Executing step $step"
  if [ "$step" -eq 0 ]; then
    step0 "$1" || echo_error 1 "Step 0 failed"
  elif [ "$step" -eq 1 ]; then
    step1 || echo_error 1 "Step 1 failed"
  elif [ "$step" -eq 2 ]; then
    step2 || echo_error 1 "Step 2 failed"
  elif [ "$step" -eq 3 ]; then
    step3 || echo_error 1 "Step 3 failed"
  elif [ "$step" -eq 4 ]; then
    step4 || echo_error 1 "Step 4 failed"
  else
    echo_error 1 "Step $step is not implemented"
  fi

  echo_info "Step $step completed successfully"
  return 0
}

step0() {
  echo_info "Starting step 0: Initial system preparation"

  echo_info "Stopping any running student4lab processes"
  pkill -f student4lab || echo_info "No student4lab processes found to kill" $?

  echo_info "Testing network connectivity"
  test_network || echo_info "Network test completed with issues, continuing anyway" $?

  if [ "$user" -eq 1 ]; then
      echo_info "User mode enabled, performing system updates"

      echo_info "Waiting for apt locks"
      wait_apt || echo_error 1 "Failed to wait for apt locks"

      # Use echo_stop before system updates
      echo_stop "System updates" "Will update all system packages"

      # Most verbose with user interaction
      if [ "$dbg" -eq 1 ] && [ "$user" -eq 1 ]; then
          echo_info "Running apt-get --allow-releaseinfo-change update (verbose interactive mode)"
          apt-get --allow-releaseinfo-change update || echo_error 1 "Failed to update release info"

          echo_info "Waiting for apt locks after release info update"
          wait_apt || echo_info "Apt lock wait issues after release info update, continuing" $?

          echo_info "Running apt-get update"
          apt-get update || echo_error 1 "Failed to update package lists"

          echo_info "Waiting for apt locks after package list update"
          wait_apt || echo_info "Apt lock wait issues after package list update, continuing" $?

          echo_info "Running apt-get full-upgrade"
          apt-get full-upgrade || echo_error 1 "Failed to upgrade packages"
      # Verbose but non-interactive
      elif [ "$dbg" -eq 1 ] && [ "$user" -eq 0 ]; then
          echo_info "Running non-interactive apt-get update with release info change (verbose)"
          DEBIAN_FRONTEND=noninteractive apt-get -y --allow-releaseinfo-change update || echo_error 1 "Failed to update release info"

          echo_info "Waiting for apt locks after release info update"
          wait_apt || echo_info "Apt lock wait issues after release info update, continuing" $?

          echo_info "Running apt-get update (non-interactive verbose)"
          DEBIAN_FRONTEND=noninteractive apt-get -y update || echo_error 1 "Failed to update package lists"

          echo_info "Waiting for apt locks after package list update"
          wait_apt || echo_info "Apt lock wait issues after package list update, continuing" $?

          echo_info "Running apt-get full-upgrade (non-interactive verbose)"
          DEBIAN_FRONTEND=noninteractive apt-get -y full-upgrade || echo_error 1 "Failed to upgrade packages"
      # Least verbose, still with interaction if needed
      elif [ "$dbg" -eq 0 ] && [ "$user" -eq 1 ]; then
          echo_info "Running quiet apt-get update with release info change (interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -q -y --allow-releaseinfo-change update || echo_error 1 "Failed to update release info"

          echo_info "Waiting for apt locks after release info update"
          wait_apt || echo_info "Apt lock wait issues after release info update, continuing" $?

          echo_info "Running apt-get update (quiet interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -q -y update || echo_error 1 "Failed to update package lists"

          echo_info "Waiting for apt locks after package list update"
          wait_apt || echo_info "Apt lock wait issues after package list update, continuing" $?

          echo_info "Running apt-get upgrade (quiet interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -q -y upgrade || echo_error 1 "Failed to upgrade packages"
      # Least verbose, no interaction (fails on interaction)
      else
          echo_info "Running silent apt-get update with release info change (non-interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -qq -y --allow-releaseinfo-change update || echo_error 1 "Failed to update release info"

          echo_info "Waiting for apt locks after release info update"
          wait_apt || echo_info "Apt lock wait issues after release info update, continuing" $?

          echo_info "Running apt-get update (silent non-interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -qq -y update || echo_error 1 "Failed to update package lists"

          echo_info "Waiting for apt locks after package list update"
          wait_apt || echo_info "Apt lock wait issues after package list update, continuing" $?

          echo_info "Running apt-get upgrade (silent non-interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -qq -y upgrade || echo_error 1 "Failed to upgrade packages"
      fi

      echo_info "Waiting for apt locks before cleanup"
      wait_apt || echo_info "Apt lock wait issues before cleanup, continuing" $?

      echo_info "Running package cleanup"
      # Apply same pattern for autoremove and clean
      if [ "$dbg" -eq 1 ] && [ "$user" -eq 1 ]; then
          echo_info "Running apt-get autoremove (verbose interactive)"
          apt-get autoremove || echo_error 1 "Failed to autoremove packages"

          echo_info "Waiting for apt locks after autoremove"
          wait_apt || echo_info "Apt lock wait issues after autoremove, continuing" $?

          echo_info "Running apt-get clean (verbose interactive)"
          apt-get clean || echo_error 1 "Failed to clean package cache"
      elif [ "$dbg" -eq 1 ] && [ "$user" -eq 0 ]; then
          echo_info "Running apt-get autoremove (verbose non-interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -y autoremove || echo_error 1 "Failed to autoremove packages"

          echo_info "Waiting for apt locks after autoremove"
          wait_apt || echo_info "Apt lock wait issues after autoremove, continuing" $?

          echo_info "Running apt-get clean (verbose non-interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -y clean || echo_error 1 "Failed to clean package cache"
      elif [ "$dbg" -eq 0 ] && [ "$user" -eq 1 ]; then
          echo_info "Running apt-get autoremove (quiet interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -q -y autoremove || echo_error 1 "Failed to autoremove packages"

          echo_info "Waiting for apt locks after autoremove"
          wait_apt || echo_info "Apt lock wait issues after autoremove, continuing" $?

          echo_info "Running apt-get clean (quiet interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -q -y clean || echo_error 1 "Failed to clean package cache"
      else
          echo_info "Running apt-get autoremove (silent non-interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -qq -y autoremove || echo_error 1 "Failed to autoremove packages"

          echo_info "Waiting for apt locks after autoremove"
          wait_apt || echo_info "Apt lock wait issues after autoremove, continuing" $?

          echo_info "Running apt-get clean (silent non-interactive)"
          DEBIAN_FRONTEND=noninteractive apt-get -qq -y clean || echo_error 1 "Failed to clean package cache"
      fi

      echo_info "Final apt lock wait"
      wait_apt || echo_info "Final apt lock wait issues, continuing" $?
  else
      echo_info "Skipping system updates (not in user mode)"
  fi
  
  echo_info "Installing required dependencies"
  echo_info "Waiting for apt locks"
  wait_apt || echo_error 1 "Failed to wait for apt locks"

  echo_stop "Installing system packages" "Will modify system packages"

  # Most verbose with user interaction
  if [ "$dbg" -eq 1 ] && [ "$user" -eq 1 ]; then
      echo_info "Installing dependencies (verbose interactive mode)"
      apt-get install \
      # installer4lab deps
      echo_info "Installation status: $?"
  # Verbose but non-interactive
  elif [ "$dbg" -eq 1 ] && [ "$user" -eq 0 ]; then
      echo_info "Installing dependencies (verbose non-interactive mode)"
      DEBIAN_FRONTEND=noninteractive apt-get -y install \
      # installer4lab deps
      echo_info "Installation status: $?"
  # Least verbose, still with interaction if needed
  elif [ "$dbg" -eq 0 ] && [ "$user" -eq 1 ]; then
      echo_info "Installing dependencies (quiet interactive mode)"
      DEBIAN_FRONTEND=noninteractive apt-get -q -y install \
      # installer4lab deps
      echo_info "Installation status: $?"
  # Least verbose, no interaction (fails on interaction)
  else
      echo_info "Installing dependencies (silent non-interactive mode)"
      DEBIAN_FRONTEND=noninteractive apt-get -qq -y install \
      # installer4lab deps
      echo_info "Installation status: $?"
  fi

  # Install development packages if devel mode is enabled
  if [ "$devel" -eq 1 ]; then
      echo_info "Development mode enabled, installing additional packages"
      echo_info "Waiting for apt locks before development package installation"
      wait_apt || echo_error 1 "Failed to wait for apt locks"

      echo_stop "Installing development packages" "Will modify system packages"

      # Most verbose with user interaction
      if [ "$dbg" -eq 1 ] && [ "$user" -eq 1 ]; then
          echo_info "Installing development packages (verbose interactive mode)"
          apt-get install \
          # installer4lab devps
          echo_info "Development packages installation status: $?"
      # Verbose but non-interactive
      elif [ "$dbg" -eq 1 ] && [ "$user" -eq 0 ]; then
          echo_info "Installing development packages (verbose non-interactive mode)"
          DEBIAN_FRONTEND=noninteractive apt-get -y install \
          # installer4lab devps
          echo_info "Development packages installation status: $?"
      # Least verbose, still with interaction if needed
      elif [ "$dbg" -eq 0 ] && [ "$user" -eq 1 ]; then
          echo_info "Installing development packages (quiet interactive mode)"
          DEBIAN_FRONTEND=noninteractive apt-get -q -y install \
          # installer4lab devps
          echo_info "Development packages installation status: $?"
      # Least verbose, no interaction (fails on interaction)
      else
          echo_info "Installing development packages (silent non-interactive mode)"
          DEBIAN_FRONTEND=noninteractive apt-get -qq -y install \
          # installer4lab devps
          echo_info "Development packages installation status: $?"
      fi
  fi

  echo_info "Setting up user profile"
  new_profile || echo_error 1 "Failed to set up new profile"

  # Run preinstall script in prep or user mode
  if [ $prep -eq 1 ] || [ "$user" -eq 1 ]; then
    echo_info "Preinstall or user mode detected, running preinstall script"
    echo_info "Waiting for apt locks before preinstall"
    wait_apt || echo_error 1 "Failed to wait for apt locks"

    local po
    po=""
    if [ $devel -eq 1 ]; then
      po=" devel"
      echo_info "Adding devel parameter to preinstall script"
    fi

    echo_stop "Running preinstall script" "Will execute /home/pi/.mentor/preinstall.sh$po"
    echo_info "Executing preinstall script with: /home/pi/.mentor/preinstall.sh$po"
    bash -c "/home/pi/.mentor/preinstall.sh$po" 2>&1 | tee /home/pi/.mentor/preinstall_output.log

    preinstall_status=${PIPESTATUS[0]}
    echo_info "Preinstall script exited with status: $preinstall_status"

    if [ "$preinstall_status" -ne 0 ]; then
        echo_error 1 "Preinstall script failed with exit code $preinstall_status"
        
    fi

    echo_info "Creating .prepared marker file"
    touch /home/pi/.mentor/.prepared || echo_info "Failed to create .prepared marker, continuing anyway" $?

    if [ $prep -eq 1 ]; then
      echo_info "Prep mode only, exiting after preinstall"
      return 0
    fi
  fi

  echo_info "Creating system files"
  create_files || echo_error 1 "Failed to create system files"

  echo_info "Setting up auto-login for pi user"
  mkdir -p /etc/systemd/system/getty@tty1.service.d || echo_error 1 "Failed to create getty service directory"

  echo_info "Writing autologin configuration"
  if ! echo "[Service]
  ExecStart=
  ExecStart=-/sbin/agetty --autologin pi --noclear %I \$TERM" > /etc/systemd/system/getty@tty1.service.d/autologin.conf; then
    echo_error 1 "Failed to write autologin configuration" 1
    
  fi

  echo_info "Backing up sudoers file"
  cp -rf /etc/sudoers /etc/sudoers.mentorbak || echo_error 1 "Failed to backup sudoers file"

  echo_info "Modifying sudoers file to enable passwordless sudo"
  sed -i 's/%sudo\s\+ALL=(ALL:ALL)\s\+ALL/%sudo ALL=(ALL) NOPASSWD: ALL/' /etc/sudoers || echo_error 1 "Failed to modify sudoers file"

  echo_info "Validating sudoers file"
  if visudo -c; then
    echo_info "Sudoers file validation passed"
  else
    echo_info "Sudoers file validation failed, restoring backup"
    mv -f /etc/sudoers.mentorbak /etc/sudoers || echo_error 1 "Failed to restore sudoers backup"
  fi

  echo_stop "Removing pi user password" "Security implications: auto-login will be enabled"
  passwd -d pi || echo_error 1 "Failed to remove password for pi user"

  echo_info "Setting default target to multi-user (console)"
  systemctl set-default multi-user.target || echo_error 1 "Failed to set default target"

  if [ "$user" -eq 1 ]; then
  	  echo_info "User mode enabled, setting next step to 1 and rebooting"
  		set_step 1 || echo_error 1 "Failed to set next step to 1"
    echo_stop "Rebooting system" "System will restart to continue setup at step 1"
    rere
  elif [ $prep -ne 1 ]; then
  	  echo_info "Standard mode enabled, setting next step to 2 and rebooting"
  		set_step 2 || echo_error 1 "Failed to set next step to 2"
  		echo_stop "Rebooting system" "System will restart to continue setup at step 2"
		rere
  fi
}

step12() {
  echo_info "Starting SSH configuration (step 1-2)"

  # Stop SSH service
  echo_info "Stopping SSH service"
  systemctl stop ssh || echo_error 1 "Failed to stop SSH service"

  # Create SSH directory if it doesn't exist
  if [ ! -d /ssh ]; then
    echo_info "Creating /ssh directory"
    mkdir -p /ssh || echo_error 1 "Failed to create /ssh directory"
  fi

  # Ensure .ssh directory exists for the pi user
  if [ ! -d /home/pi/.ssh ]; then
    echo_info "Creating /home/pi/.ssh directory"
    mkdir -p /home/pi/.ssh || echo_error 1 "Failed to create /home/pi/.ssh directory"
    chown pi:pi /home/pi/.ssh || echo_error 1 "Failed to change ownership of /home/pi/.ssh"
  fi

  # Back up SSH configuration files before modification
  if [ -f /etc/ssh/ssh_config ]; then
    echo_info "Backing up ssh_config"
    cp /etc/ssh/ssh_config /etc/ssh/ssh_config.mentorbak || echo_info "Failed to create ssh_config backup, continuing anyway" $?
  fi

  if [ -f /etc/ssh/sshd_config ]; then
    echo_info "Backing up sshd_config"
    cp /etc/ssh/sshd_config /etc/ssh/sshd_config.mentorbak || echo_info "Failed to create sshd_config backup, continuing anyway" $?
  fi

  if [ -f /home/pi/.ssh/authorized_keys ]; then
    echo_info "Backing up authorized_keys"
    cp /home/pi/.ssh/authorized_keys /home/pi/.ssh/authorized_keys.mentorbak || echo_info "Failed to create authorized_keys backup, continuing anyway" $?
  fi

  # Set correct permissions for SSH files and directories
  echo_info "Setting SSH directory permissions"
  chown_chmod 700 /home/pi/.ssh || echo_error 1 "Failed to set permissions on /home/pi/.ssh"

  # Check if id_rsa file exists before trying to set permissions
  if [ -f /home/pi/.ssh/id_rsa ]; then
    echo_info "Setting permissions for id_rsa"
    chown_chmod 600 /home/pi/.ssh/id_rsa || echo_error 1 "Failed to set permissions on id_rsa"
  fi

  # Check if id_rsa.pub file exists before trying to set permissions
  if [ -f /home/pi/.ssh/id_rsa.pub ]; then
    echo_info "Setting permissions for id_rsa.pub"
    chown_chmod 644 /home/pi/.ssh/id_rsa.pub || echo_error 1 "Failed to set permissions on id_rsa.pub"
  fi

  # Set permissions on SSH configuration directories
  echo_info "Setting permissions on /etc/ssh"
  chmod 755 /etc/ssh || echo_error 1 "Failed to set permissions on /etc/ssh"

  echo_info "Setting permissions on ssh_config"
  chmod 644 /etc/ssh/ssh_config || echo_error 1 "Failed to set permissions on ssh_config"

  echo_info "Setting permissions on sshd_config"
  chmod 644 /etc/ssh/sshd_config || echo_error 1 "Failed to set permissions on sshd_config"

  # Check if ssh_host_rsa_key.pub exists before setting permissions
  if [ -f /etc/ssh/ssh_host_rsa_key.pub ]; then
    echo_info "Setting permissions on ssh_host_rsa_key.pub"
    chmod 600 /etc/ssh/ssh_host_rsa_key.pub || echo_error 1 "Failed to set permissions on ssh_host_rsa_key.pub"
  fi

  # Prepare authorized_keys file
  echo_stop "Configuring SSH keys" "Will modify SSH authentication configuration"

  # Remove and recreate authorized_keys file
  echo_info "Removing existing authorized_keys file"
  rm -f /home/pi/.ssh/authorized_keys || echo_error 1 "Failed to remove authorized_keys"

  echo_info "Creating new authorized_keys file"
  touch /home/pi/.ssh/authorized_keys || echo_error 1 "Failed to create authorized_keys"

  echo_info "Setting ownership of authorized_keys"
  chown pi:pi /home/pi/.ssh/authorized_keys || echo_error 1 "Failed to change ownership of authorized_keys"

  # Add SSH keys
  local authorized_keys
  authorized_keys=$(cat <<-EOF
# installer4lab id_ed25519.pub
EOF
  )
  echo_info "Adding default keys to authorized_keys"
  if ! echo "$authorized_keys" >> /home/pi/.ssh/authorized_keys; then
    echo_error 1 "Failed to add default keys to authorized_keys" 1
    
  fi

  echo_info "Backing up new authorized_keys"
  cp /home/pi/.ssh/authorized_keys /home/pi/.ssh/authorized_keys.mentorbak || echo_info "Failed to backup new authorized_keys, continuing anyway" $?

  # Add id_rsa.pub key if it exists
  if [ -f /home/pi/.ssh/id_rsa.pub ]; then
    echo_info "Adding user's public key from id_rsa.pub"
    cat /home/pi/.ssh/id_rsa.pub >> /home/pi/.ssh/authorized_keys || echo_error 1 "Failed to add id_rsa.pub to authorized_keys"
  fi

  # Check if known_keys directory exists
  if [ -d /home/pi/.mentor/known_keys ]; then
    echo_info "Found known_keys directory, adding keys"
    # Add all public keys from known_keys directory
    key_count=0
    for pub_file in /home/pi/.mentor/known_keys/*; do
      if [ -f "$pub_file" ]; then
        echo_info "Adding key from $pub_file"
        cat "$pub_file" >> /home/pi/.ssh/authorized_keys || echo_error 1 "Failed to add $pub_file to authorized_keys"
        key_count=$((key_count + 1))
      fi
    done
    echo_info "Added $key_count additional keys from known_keys directory"
  else
    echo_info "No known_keys directory found"
  fi

  # Create known_hosts file
  echo_info "Setting up known_hosts file"
  if [ -f /home/pi/.ssh/known_hosts ]; then
    echo_info "Backing up existing known_hosts"
    cp -f /home/pi/.ssh/known_hosts /home/pi/.ssh/known_hosts.mentorbak || echo_info "Failed to backup known_hosts, continuing anyway" $?

    echo_info "Removing existing known_hosts"
    rm -f /home/pi/.ssh/known_hosts || echo_error 1 "Failed to remove known_hosts"
  fi

  echo_info "Creating new known_hosts file"
  touch /home/pi/.ssh/known_hosts || echo_error 1 "Failed to create known_hosts"

  # Process authorized_keys to create known_hosts
  echo_info "Processing authorized_keys to create known_hosts entries"
  if [ -s /home/pi/.ssh/authorized_keys ]; then
    echo_info "Using HOST=$HOST for known_hosts entries"

    # Initialize line counter for better logging
    local line_count=0
    while IFS= read -r line; do
      # Skip comment lines
      if [[ "$line" == \#* ]]; then
        continue
      fi
      if [[ -n "$line" ]]; then
        line_without_first_and_last_word=$(echo "$line" | awk '{$1=""; $NF=""; print $0}' | xargs)
        echo_info "Adding key for $HOST: ${line_without_first_and_last_word:0:30}..."
        echo "$HOST $line_without_first_and_last_word"
        line_count=$((line_count + 1))
      fi
    done < /home/pi/.ssh/authorized_keys > /home/pi/.ssh/known_hosts || echo_error 1 "Failed to write known_hosts"

    echo_info "Added $line_count entries to known_hosts"
  else
    echo_info "authorized_keys is empty, no entries added to known_hosts"
  fi

  # Set correct permissions for known_hosts and authorized_keys
  echo_info "Setting permissions for known_hosts"
  chown_chmod 644 /home/pi/.ssh/known_hosts || echo_error 1 "Failed to set permissions on known_hosts"

  echo_info "Setting permissions for authorized_keys"
  chown_chmod 600 /home/pi/.ssh/authorized_keys || echo_error 1 "Failed to set permissions on authorized_keys"

  # Enable SSH service
  echo_info "Enabling SSH service"
  systemctl enable ssh || echo_error 1 "Failed to enable SSH service"

  echo_info "Setting up AudytorStudent configuration"
  # Define configuration values
  PROTOCOL=TCP
  HIDE_CURSOR=1
  MAXIMIZE=1
  ACK_RETRY=3
  ACK_WAIT=3000
  PING=10000
  PING_MISS=3
  LNR_ADD=1
  LNR_SWAP=0
  MENU_TIMER=1500
  SERIAL=ttyAMA0

  pairs="MIC_TYPE $MIC_TYPE DEBUG_LEVEL $DEBUG_LEVEL HOST $HOST VER_APP $VER_APP VER_LIB $VER_LIB PORT $PORT PROTOCOL $PROTOCOL HIDE_CURSOR $HIDE_CURSOR MAXIMIZE $MAXIMIZE ACK_RETRY $ACK_RETRY ACK_WAIT $ACK_WAIT PING $PING PING_MISS $PING_MISS LNR_ADD $LNR_ADD LNR_SWAP $LNR_SWAP MENU_TIMER $MENU_TIMER USERNAME pi SERIAL $SERIAL"

  echo_info "Creating Mentor config directory"
  sudo -u pi mkdir -p /home/pi/.config/Mentor || echo_error 1 "Failed to create /home/pi/.config/Mentor"

  echo_info "Removing existing AudytorStudent.conf"
  rm -rf /home/pi/.config/Mentor/AudytorStudent.conf || echo_error 1 "Failed to remove /home/pi/.config/Mentor/AudytorStudent.conf"

  echo_info "Creating AudytorStudent.conf"
  sudo -u pi touch /home/pi/.config/Mentor/AudytorStudent.conf || echo_error 1 "Failed to create /home/pi/.config/Mentor/AudytorStudent.conf"

  echo_info "Writing AudytorStudent.conf header"
  sudo -u pi echo "[General]" | tee /home/pi/.config/Mentor/AudytorStudent.conf || echo_error 1 "Failed to write to AudytorStudent.conf"

  echo_info "Writing configuration parameters to AudytorStudent.conf"
  local param_count=0
  while read -r key && read -r value; do
    echo "$key=$value" | tee -a /home/pi/.config/Mentor/AudytorStudent.conf || echo_info "Failed to write parameter $key, continuing"
    param_count=$((param_count + 1))
  done < <(echo "$pairs" | tr ' ' '\n')

  echo_info "Wrote $param_count parameters to AudytorStudent.conf"
  echo_info "SSH and configuration setup completed successfully"
  return 0
}

step1() {
  echo_info "Starting step 1: SSH configuration only"
  step12 || echo_error 1 "SSH configuration (step12) failed"
  echo_info "Setting next step to 3"
  set_step 3 || echo_error 1 "Failed to set step to 3"
  echo_info "Clearing screen and exiting step 1"
  clear
  return 0
}

step2() {
  echo_info "Starting step 2: SSH configuration and proceeding to step 3"
  step12 || echo_error 1 "SSH configuration (step12) failed"
  echo_info "Proceeding to step 3"
  step3 || echo_error 1 "Step 3 failed"
}

step3() {
  echo_info "Starting step 3: User groups and hostname configuration"

  # Check for wait marker file
  if [ -f /home/pi/.mentor/wait.marker ]; then
    echo_info "Found wait marker, clearing screen and exiting"
    clear
    return 0
  fi

  # Get IP address for hostname generation
  local ip_address
  ip_address=$(hostname -I | awk '{print $1}') || echo_error 1 "Failed to get IP address"
  echo_info "Current IP address: $ip_address"

  local new_hostname
  new_hostname=rpi$(echo "$ip_address" | tr -d '.')
  echo_info "Generated new hostname: $new_hostname"

  # Add user to required groups
  echo_info "Adding pi user to dialout group"
  usermod -a -G dialout pi || echo_error 1 "Failed to add pi to dialout group"

  echo_info "Adding pi user to tty group"
  usermod -a -G tty pi || echo_error 1 "Failed to add pi to tty group"

  echo_info "Adding pi user to video group"
  usermod -a -G video pi || echo_error 1 "Failed to add pi to video group"

  echo_info "Setting next step to 4"
  set_step 4 || echo_error 1 "Failed to set step to 4"

  echo_info "Scheduling system reboot in 1 minute"
  shutdown -r +1 >/dev/null 2>&1 || echo_error 1 "Failed to schedule reboot"

  echo_stop "Changing system hostname" "Will modify /etc/hostname and /etc/hosts"

  # Update hostname with error handling
  echo_info "Writing new hostname to /etc/hostname"
  if ! echo "$new_hostname" > /etc/hostname; then
    echo_error 1 "Failed to update hostname file" 1
  fi

  # Create hosts file backup
  echo_info "Creating backup of /etc/hosts"
  cp /etc/hosts /etc/hosts.mentorbak || echo_error 1 "Failed to backup hosts file" $?

  # Update hosts file with error handling
  echo_info "Updating hostname in /etc/hosts"
  sed -i "s/127.0.1.1.*/127.0.1.1 $new_hostname/" /etc/hosts || { 
    echo_info "Failed to update hosts file, restoring backup" $?; 
    cp /etc/hosts.mentorbak /etc/hosts || echo_info "Failed to restore hosts backup, continuing anyway" $?; 
  }

  # Verify the changes
  echo_info "Verifying hostname changes"
  if ! grep -q "$new_hostname" /etc/hostname; then
    echo_error 1 "Verification failed: new hostname not found in /etc/hostname"
  fi

  if ! grep -q "127.0.1.1.*$new_hostname" /etc/hosts; then
    echo_error 1 "Verification failed: new hostname not found in /etc/hosts"
  fi

  echo_info "Hostname successfully updated to $new_hostname"
  echo_info "Step 3 completed successfully, reboot scheduled"
  return 0
}

step4() {
  echo_info "Starting step 4: Final configuration and marker creation"

  # Get IP address with error handling
  local ip_address
  ip_address=$(hostname -I | awk '{print $1}') || {
    echo_error 1 "Failed to get IP address" $?
  }
  echo_info "Current IP address: $ip_address"

  # Create a marker file with collected system information
  echo_info "Creating prepare4lab.marker with system information"
  create_marker_file "/home/pi/.mentor" "prepare4lab.marker" "$(collect_system_info)" || {
    echo_error 1 "Failed to create marker file" $?
    
  }

  # Set final step
  echo_info "Setting next step to 5 (final step)"
  set_step 5 || echo_error 1 "Failed to set step to 5"

  echo_info "Step 4 completed successfully"
  return 0
}
  
# Function to create a marker file similar to the C# version
create_marker_file() {
  local marker="$1"
  local filename="$2"
  local lines_to_append="$3"
  
  echo_info "Creating marker file: marker=$marker, filename=$filename"

  # Check that at least the first parameter is provided
  if [ -z "$marker" ]; then
    echo_error 1 "Marker path parameter is required"
    
  fi

  # Handle path construction
  if [[ ! "$marker" == *.marker ]]; then
    if [[ -z "$filename" ]]; then
      filename="$(basename "$marker" | tr '[:upper:]' '[:lower:]').marker"
      echo_info "No filename provided, generated filename: $filename"
    fi
    marker="${marker}/${filename}"
    echo_info "Constructed marker path: $marker"
  fi

  filename="$(basename "$marker")"
  echo_info "Final marker filename: $filename"

  # Get metadata for marker file
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')" || echo_error 1 "Failed to get timestamp"

  local username
  username="$(whoami)" || echo_error 1 "Failed to get username"

  local hostname
  hostname="$(hostname)" || echo_error 1 "Failed to get hostname"

  echo_info "Marker metadata: timestamp=$timestamp, user=$username, host=$hostname"

  # Create parent directory if it doesn't exist
  local marker_dir
  marker_dir="$(dirname "$marker")"
  echo_info "Ensuring marker directory exists: $marker_dir"

  mkdir -p "$marker_dir" || echo_error 1 "Failed to create directory for marker file: $marker_dir" $?

  # Write initial marker content
  echo_info "Writing marker file header"
  if ! {
    echo "# $filename"
    echo "WERSJA=$WERSJA"
    echo "# "
    echo "# $timestamp"
    echo "# ${username}@${hostname}"
    if [[ -n "$HOST" && "$HOST" != "0.0.0.0" ]]; then
      echo "# ${HOST}:${PORT}"
    fi
    echo "# ---"
    echo "# "
  } > "$marker"; then
    echo_error 1 "Failed to write to marker file: $marker" 1
    
  fi

  # Append additional lines if provided
  if [ -n "$lines_to_append" ]; then
    echo_info "Appending additional content to marker file"
    if ! echo "$lines_to_append" >> "$marker"; then
      echo_error 1 "Failed to append content to marker file: $marker" 1
      
    fi
  else
    echo_info "No additional content to append to marker file"
  fi

  # Add footer
  echo_info "Adding footer to marker file"
  if ! {
    echo "# ---"
    echo "# "
  } >> "$marker"; then
    echo_error 1 "Failed to write footer to marker file: $marker" 1
    
  fi

  echo_info "Successfully created marker file: $marker"
  return 0
}

# Collect system information to append to the marker file
collect_system_info() {
  echo_info "Collecting system information for marker file"

  local info=""
  info+="# ==========================================================\n"
  info+="# SYSTEM INFORMATION\n"
  info+="# ==========================================================\n"
  info+="# \n"

  # Kernel information
  echo_info "Collecting kernel information"
  local kernel_info
  kernel_info=$(uname -a 2>/dev/null) || kernel_info="Failed to get kernel info"
  info+="# Kernel Information:\n"
  info+="# ------------------\n"
  info+="# $kernel_info\n"
  info+="# \n"

  # OS information
  echo_info "Collecting OS information"
  local debian_version
  debian_version=$(cat /etc/debian_version 2>/dev/null) || debian_version="unknown"
  info+="# OS Information:\n"
  info+="# --------------\n"
  info+="# Debian Version: $debian_version\n"
  info+="# LSB Release:\n"

  if command -v lsb_release >/dev/null 2>&1; then
    echo_info "Collecting LSB release information"
    local lsb_info
    lsb_info=$(lsb_release -a 2>/dev/null | sed 's/^/# /') || lsb_info="# LSB Release information retrieval failed"
    info+="$lsb_info\n"
  else
    info+="# LSB Release information not available\n"
  fi
  info+="# \n"

  # Network information
  echo_info "Collecting network information"
  local hostname_info
  hostname_info=$(hostname 2>/dev/null) || hostname_info="unknown"

  local domain_name
  domain_name=$(hostname -d 2>/dev/null) || domain_name="N/A"

  local fqdn
  fqdn=$(hostname -f 2>/dev/null) || fqdn="N/A"

  local primary_ip
  primary_ip=$(hostname -I 2>/dev/null | awk '{print $1}') || primary_ip="unknown"

  local all_ips
  all_ips=$(hostname -I 2>/dev/null) || all_ips="unknown"

  info+="# Hostname & Network Information:\n"
  info+="# ------------------------------\n"
  info+="# Hostname: $hostname_info\n"
  info+="# Domain Name: $domain_name\n"
  info+="# Fully Qualified Domain Name: $fqdn\n"
  info+="# Primary IP: $primary_ip\n"
  info+="# All IPs: $all_ips\n"
  info+="# \n"

  # Network interfaces
  echo_info "Collecting network interface information"
  info+="# Network Interfaces:\n"
  info+="# ------------------\n"
  
  if command -v ip >/dev/null 2>&1; then
    local interfaces
    interfaces=$(ip -br addr show 2>/dev/null) || interfaces="Failed to get interface information"
    
    # Fix: Use process substitution to avoid the pipeline subshell
    while read -r line; do
      info+="# $line\n"
    done < <(echo "$interfaces")
  else
    info+="# ip command not available\n"
  fi
  info+="# \n"

  # Routing table
  echo_info "Collecting routing table"
  info+="# Routing Table:\n"
  info+="# -------------\n"

  if command -v ip >/dev/null 2>&1; then
    local routes
    routes=$(ip route 2>/dev/null) || routes="Failed to get routing information"
    # Use parameter expansion instead of pipe to sed
    local routes_commented="${routes//$'\n'/$'\n# '}"
    info+="# ${routes_commented}\n"
  else
    info+="# ip command not available\n"
  fi
  info+="# \n"

  # DNS settings
  echo_info "Collecting DNS settings"
  info+="# DNS Settings:\n"
  info+="# ------------\n"
  if [ -f /etc/resolv.conf ]; then
    local dns_settings
    dns_settings=$(grep -v "^#" /etc/resolv.conf 2>/dev/null) || dns_settings="Failed to read DNS settings"
    # Use parameter expansion instead of pipe to sed
    local dns_commented="${dns_settings//$'\n'/$'\n# '}"
    info+="# ${dns_commented}\n"
  else
    info+="# resolv.conf not found\n"
  fi
  info+="# \n"

  # Hardware information
  echo_info "Collecting hardware information"
  info+="# Hardware Information:\n"
  info+="# -------------------\n"
  info+="# CPU:\n"

  if command -v lscpu >/dev/null 2>&1; then
    local cpu_info
    cpu_info=$(lscpu 2>/dev/null | grep "Model name\|Architecture\|CPU(s)\|CPU MHz") || cpu_info="Failed to get CPU info"
    # Use parameter expansion instead of pipe to sed
    local cpu_commented="${cpu_info//$'\n'/$'\n# '}"
    info+="# ${cpu_commented}\n"
  else
    info+="# lscpu command not available\n"
  fi
  info+="# \n"

  # Memory information
  echo_info "Collecting memory information"
  info+="# Memory Information:\n"
  info+="# -----------------\n"

  if command -v free >/dev/null 2>&1; then
    local memory_info
    memory_info=$(free -h 2>/dev/null) || memory_info="Failed to get memory info"
    # Use parameter expansion instead of pipe to sed
    local memory_commented="${memory_info//$'\n'/$'\n# '}"
    info+="# ${memory_commented}\n"
  else
    info+="# free command not available\n"
  fi
  info+="# \n"

  # Storage information
  echo_info "Collecting storage information"
  info+="# Storage Information:\n"
  info+="# ------------------\n"
  info+="# Root Filesystem:\n"

  if command -v df >/dev/null 2>&1; then
    local root_storage
    root_storage=$(df -h / 2>/dev/null) || root_storage="Failed to get root filesystem info"
    # Use parameter expansion instead of pipe to sed
    local root_storage_commented="${root_storage//$'\n'/$'\n# '}"
    info+="# ${root_storage_commented}\n"

    info+="# \n"
    info+="# All Mounted Filesystems:\n"

    local all_storage
    all_storage=$(df -h 2>/dev/null) || all_storage="Failed to get filesystem info"
    # Use parameter expansion instead of pipe to sed
    local all_storage_commented="${all_storage//$'\n'/$'\n# '}"
    info+="# ${all_storage_commented}\n"
  else
    info+="# df command not available\n"
  fi
  info+="# \n"

  # Package information
  echo_info "Collecting package information"
  info+="# Installed Packages Information:\n"
  info+="# -----------------------------\n"

  if command -v dpkg >/dev/null 2>&1; then
    local qt_version
    qt_version=$(dpkg -s libqt5core5a 2>/dev/null | grep '^Version:' | awk '{print $2}') || qt_version="not installed"
    info+="# Qt Version: $qt_version\n"

    # Check common packages
    for pkg in python3 gcc g++ make openssl libssl-dev openssh-server openssh-client; do
      local version
      version=$(dpkg -s $pkg 2>/dev/null | grep '^Version:' | awk '{print $2}') || version="not installed"
      info+="# $pkg: $version\n"
    done
  else
    info+="# dpkg command not available\n"
  fi
  info+="# \n"

  # Service status
  echo_info "Collecting service status information"
  info+="# Service Status:\n"
  info+="# -------------\n"

  if command -v systemctl >/dev/null 2>&1; then
    for service in ssh dhcpcd networking cron systemd-timesyncd; do
      local status
      status=$(systemctl is-active $service 2>/dev/null) || status="inactive"
      info+="# $service: $status\n"
    done
  else
    info+="# systemctl command not available\n"
  fi
  info+="# \n"

  # System uptime
  echo_info "Collecting system uptime"
  info+="# System Uptime:\n"
  info+="# ------------\n"

  if command -v uptime >/dev/null 2>&1; then
    local uptime_info
    uptime_info=$(uptime 2>/dev/null) || uptime_info="Failed to get uptime"
    info+="# $uptime_info\n"
  else
    info+="# uptime command not available\n"
  fi
  info+="# \n"

  # Environment variables
  echo_info "Collecting environment variables"
  info+="# Environment Variables:\n"
  info+="# --------------------\n"
  info+="# PATH: $PATH\n"
  info+="# USER: $USER\n"
  info+="# HOME: $HOME\n"
  info+="# SHELL: $SHELL\n"
  info+="# \n"

  # Date and time
  echo_info "Collecting date and time information"
  info+="# Date and Time:\n"
  info+="# ------------\n"

  local current_time
  current_time=$(date 2>/dev/null) || current_time="Failed to get current time"
  info+="# Current Time: $current_time\n"

  local timezone
  if [ -f /etc/timezone ]; then
    timezone=$(cat /etc/timezone 2>/dev/null) || timezone="unknown"
  else
    timezone="unknown"
  fi
  info+="# Timezone: $timezone\n"
  info+="# \n"

  info+="# ==========================================================\n"

  echo_info "System information collection completed"
  echo "$info"
  return 0
}

main "$@"