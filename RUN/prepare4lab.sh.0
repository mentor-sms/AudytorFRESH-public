#!/bin/bash
# -*- coding: utf-8 -*-

# installer4lab STEP 0 //prepare4lab.sh.0
WERSJA=7.7.0
echo prepare4lab ver: $WERSJA
# WERSJA nie moze byc zadeklarowana ponizej 10 linii skryptu!

MIC_TYPE=0 # 1 dla dynamicznego
DEBUG_LEVEL=2
# 0 - debug, sieczka
# 1 - informacyjnie, nie dla klienta
# 2 - ostrzezenia, domyslne
# 3 - bledy
# 4 - bledy krytyczne
# 5 - bledy kryczyne i komunikacja szeregowa
# 6 - bledy krytyczne i komunikacja LAN

HOST=0.0.0.0
VER_PC=0.0.0
PORT=0
# installer4lab vars
# HOST, PORT, VER_PC

echo installer4lab ver: $VER_PC

# todo - automate via installer4lab:
VER_APP="$WERSJA"
VER_LIB="$WERSJA"

prep=0 # runs preinstall.sh
user=0 # runs preinstall.sh, apt full-upgrade
dbg=0 # waits for [Enter] often
devel=0
clear=1 # clears step file before beginning by default
job="" # arg0 for step 1+
quick=0
args_string="" # additional arguments as string

  # Check for help option first
  if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  show_help
  exit 0
  fi

if [ $# -gt 0 ]; then
  # First argument is the job type (release or devel)
  job="$1"
  shift

  # Store original arguments for later use
  original_args=("$job")

  # Process job type first
  if [ "$job" = "release" ]; then
    echo "MODE: release"
    job="RELEASE"
  elif [ "$job" = "devel" ]; then
    echo "MODE: devel"
    job="DEVEL"
    devel=1
  else
    echo "MODE: unknown job type: $job"
    echo "Valid job types: release, devel"
    exit 1
  fi

  # Process remaining arguments
  while [ $# -gt 0 ]; do
    original_args+=("$1")
    case "$1" in
      --user)
        echo "OPTION: user mode enabled"
        user=1
        clear=1 # reinstall when --user is specified
        ;;
      --debug)
        echo "OPTION: debug mode enabled"
        dbg=1
        ;;
      --continue)
        echo "OPTION: continue mode enabled"
        clear=0 # don't clear step file
        ;;
      --quick)
        echo "OPTION: quick mode enabled"
        quick=1
        ;;
      *)
        echo "WARNING: Unknown option: $1"
        ;;
    esac
    shift
  done
  # Build the arguments string for later use
  args_string=""
  for arg in "${original_args[@]:1}"; do
    args_string="$args_string $arg"
  done

  # Add --user to job name if user mode is enabled
  if [ "$user" -eq 1 ]; then
    job="U$job"
    echo "Final mode: $job with user privileges"
  else
    echo "Final mode: $job"
  fi

  # Add debug flag to environment if debug mode is enabled
  if [ "$dbg" -eq 1 ]; then
    echo "Debug mode is active"
  fi
else
  echo "MODE: not given!"
  echo "Usage: $0 [release|devel] [--user] [--debug] --continue [--quick]"
  echo "Usage: $0 [release|devel] [--user] [--debug] [--continue] [--quick]"
  exit 1
fi

echo "3, 2, 1..."
sleep 4

echo_dbg() {
  echo "$1"
  if [ $dbg -eq 1 ] && [ $quick -eq 0 ]; then
    echo "Press [Enter]..."
    read -r
  fi
}

echo_wait() {
  echo "$1"
  if [ $user -eq 1 ] || [ $dbg -eq 1 ]; then
    if [ $quick -eq 0 ]; then
      echo "Press [Enter] to continue, Ctrl+C to cancel..."
      read -r
    fi
  fi
}

show_help() {
  echo "Usage: $0 [release|devel] [--user] [--debug] [--continue] [--quick]"
  echo ""
  echo "Job type (required):"
  echo "  release           Configure system for release environment"
  echo "  devel             Configure system for development environment"
  echo ""
  echo "Options:"
  echo "  --user            Run in user mode (perform system upgrades)"
  echo "  --debug           Run in debug mode (more verbose, more interactive if also --user)"
  echo "  --continue        Continue from last step (don't clear state)"
  echo "  --quick           Skip confirmation prompts"
  echo ""
  echo "Example:"
  echo "  $0 release --user --debug"
  echo "  $0 devel --continue --quick"
}

rere() {
  echo_wait "Ponowne uruchomienie systemu..."
  
  # Ensure all data is written to disk
  sync || echo "Warning: sync command failed"
  
  # Try multiple methods of system reboot
  if shutdown -r -f now >/dev/null 2>&1; then
    echo "Shutdown command issued successfully"
  elif systemctl reboot >/dev/null 2>&1; then
    echo "Reboot through systemctl issued successfully"
  elif reboot >/dev/null 2>&1; then
    echo "Reboot command issued successfully"
  else
    echo "Error: All reboot methods failed, manual restart required"
    exit 1
  fi
  
  # Wait a moment for reboot to start
  sleep 5
  
  # If we get here, reboot failed
  echo "Error: System did not reboot as expected"
  exit 1
}

chown_chmod() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Error: chown_chmod requires two parameters: permissions and filename"
    exit 1
  fi
  
  if [ ! -e "$2" ]; then
    echo "Error: file or directory does not exist: $2"
    # Try to create an empty file or directory if it doesn't exist
    if [[ "$1" == *"7"* ]]; then  # If permission includes 7, likely a directory
      mkdir -p "$2" || { echo "Error: failed to create directory $2"; exit 1; }
    else
      touch "$2" || { echo "Error: failed to create file $2"; exit 1; }
    fi
  fi
  
  # Check if pi user exists
  if ! id pi &>/dev/null; then
    echo "Error: user 'pi' does not exist"
    exit 1
  fi
  
  # Set ownership
  chown pi:pi "$2" || { echo "Error: failed to change ownership of $2"; exit 1; }
  
  # Validate permissions format
  if ! [[ "$1" =~ ^[0-7]{3}$ ]]; then
    echo "Error: invalid permissions format: $1"
    exit 1
  fi
  
  # Set permissions
  chmod "$1" "$2" || { echo "Error: failed to change permissions of $2"; exit 1; }
  
  # Verify changes
  local owner
  owner=$(stat -c "%U:%G" "$2")
  if [ "$owner" != "pi:pi" ]; then
    echo "Error: ownership verification failed for $2. Expected pi:pi, got $owner"
    exit 1
  fi
  
  local perms
  perms=$(stat -c "%a" "$2")
  if [ "$perms" != "$1" ]; then
    echo "Error: permission verification failed for $2. Expected $1, got $perms"
    exit 1
  fi
  
  return 0
}

wait_apt() {
  echo "Oczekiwanie na /var/lib/dpkg/lock-frontend dla apt-get..."
  
  # Maximum wait time in seconds
  local max_wait
  max_wait=300  # 5 minutes
  local start_time
  start_time=$(date +%s)
  local current_time
  local elapsed_time
  
  while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; do
    current_time=$(date +%s)
    elapsed_time=$((current_time - start_time))
    
    # Display progress every 10 seconds
    if [ $((elapsed_time % 10)) -eq 0 ]; then
      echo "Still waiting for apt lock... ($elapsed_time seconds elapsed)"
      
      # Show what process is holding the lock
      echo "Processes holding the lock:"
      fuser -v /var/lib/dpkg/lock-frontend 2>/dev/null || echo "None identified"
    fi
    
    # Check if we've waited too long
    if [ "$elapsed_time" -gt "$max_wait" ]; then
      echo "Error: Timed out waiting for apt lock after $max_wait seconds"
      echo "Attempting to check for and fix stale locks..."
      
      # Check if the process holding the lock is still running
      pid=$(fuser /var/lib/dpkg/lock-frontend 2>/dev/null)
      if [ -n "$pid" ] && ! ps -p "$pid" > /dev/null; then
        echo "Stale lock detected. Attempting to remove..."
        rm -f /var/lib/dpkg/lock-frontend || { echo "Error: Failed to remove stale lock"; exit 1; }
        rm -f /var/lib/dpkg/lock || echo "Warning: Failed to remove secondary lock"
        dpkg --configure -a || echo "Warning: dpkg --configure -a failed"
        echo "Lock files removed. Continuing..."
        break
      else
        echo "Lock is held by running process. Cannot proceed."
        exit 1
      fi
    fi
    
    sleep 1
  done
  
  echo "Lock released, proceeding with apt operations"
}

set_step() {
  step=$1
  echo_dbg "SET /home/pi/.prepare4lab.step = $step"
  
  # Validate numeric step value
  if ! echo "$step" | grep -Eq '^[0-9]+$'; then
    echo "Error: Invalid step value: $step"
    exit 1
  fi
  
  # Ensure home directory exists and is accessible
  if [ ! -d /home/pi ]; then
    echo "Error: /home/pi directory not found"
    exit 1
  fi
  
  # Remove existing step file with error handling
  if [ -f /home/pi/.prepare4lab.step ]; then
    rm -f /home/pi/.prepare4lab.step || { echo "Error: failed to remove /home/pi/.prepare4lab.step"; exit 1; }
  fi
  
  # Write new step value with error handling
  echo "$step" | sudo -u pi tee /home/pi/.prepare4lab.step > /dev/null || { echo "Error: failed to write to /home/pi/.prepare4lab.step"; exit 1; }
  
  # Verify written step value
  if [ ! -f /home/pi/.prepare4lab.step ]; then
    echo "Error: Step file was not created"
    exit 1
  fi
  
  read_step=$(<"/home/pi/.prepare4lab.step") || { echo "Error: failed to read /home/pi/.prepare4lab.step"; exit 1; }
  
  if [ "$read_step" != "$step" ]; then
    echo "Error: Step value mismatch. Expected: $step, Got: $read_step"
    exit 1
  fi
}

# installer4lab embedded-scripts

# installer4lab generate_files()

create_files() {
    CMDLINE_FILE="/boot/firmware/cmdline.txt"
    
    # Extract the "root=PARTUUID=..." part from the cmdline.txt
    ROOT_PARTUUID=$(grep -o "root=PARTUUID=[^ ]*" "$CMDLINE_FILE") || {
        echo "Error: Could not find 'root=PARTUUID' in $CMDLINE_FILE."
        exit 1
    }
    
    if [ -z "$ROOT_PARTUUID" ]; then
        echo "Error: PARTUUID extraction failed."
        exit 1
    fi
    
    echo "Extracted root PARTUUID: $ROOT_PARTUUID"
    echo "Contents of $CMDLINE_FILE before modification:"
    cat "$CMDLINE_FILE"
    echo_dbg ""
    
    # installer4lab clear generate_files
    
    if grep -q "root=" "$CMDLINE_FILE"; then
        echo "Error: cmdline.txt still contains 'root=' after overriding."
        exit 1
    fi
    
    sed -i '${/^$/d;}' "$CMDLINE_FILE" || {
        echo "Error: Failed to remove trailing newline from $CMDLINE_FILE."
        exit 1
    }

    sed -i "\$s/\$/ ${ROOT_PARTUUID}/" "$CMDLINE_FILE" || {
        echo "Error: Failed to append PARTUUID to $CMDLINE_FILE."
        exit 1
    }
    
    sed -i -e '${/^$/d;}' -e 's/[[:space:]]*$//' "$CMDLINE_FILE" || {
        echo "Error: Failed to process $CMDLINE_FILE."
        exit 1
    }

    echo "Contents of $CMDLINE_FILE after modification:"
    cat "$CMDLINE_FILE"
    echo_dbg ""
}

new_profile() {
  # Backup existing profile if it exists
  if [ -f /home/pi/.profile ]; then
    cp /home/pi/.profile /home/pi/.profile.mentorbak || true
  fi

  # Copy skeleton profile
  cp -rf /etc/skel/.profile /home/pi/.profile || { echo "Error: failed to copy .profile"; exit 1; }
  chown pi:pi /home/pi/.profile || { echo "Error: failed to change ownership of .profile"; exit 1; }
  chmod 644 /home/pi/.profile || { echo "Error: failed to set permissions on .profile"; exit 1; }
  
  # Check and ensure .mentor directory exists
  if [ ! -d /home/pi/.mentor ]; then
    echo "Error: /home/pi/.mentor directory does not exist"
    exit 1
  fi
  
  # Check for profile.sh
  if [ ! -f /home/pi/.mentor/profile.sh ]; then
    echo "Error: /home/pi/.mentor/profile.sh not found"
    exit 1
  fi
  
  # Check if profile.sh is readable
  if [ ! -r /home/pi/.mentor/profile.sh ]; then
    echo "Error: /home/pi/.mentor/profile.sh is not readable"
    # Try to fix permissions
    chmod 644 /home/pi/.mentor/profile.sh || { echo "Error: failed to make profile.sh readable"; exit 1; }
  fi
  
  # Append profile.sh
  cat /home/pi/.mentor/profile.sh >> /home/pi/.profile || { echo "Error: failed to append contents of profile.sh"; exit 1; }
  
  # Append job with arguments
  printf "\njob=%s %s\n" "$job" "${args_string} --continue" >> /home/pi/.profile || { echo "Error: failed to append job with arguments"; exit 1; }
  
  # Check for prepare4lab.run
  if [ ! -f /home/pi/.mentor/prepare4lab.run ]; then
    echo "Error: /home/pi/.mentor/prepare4lab.run not found"
    exit 1
  fi
  
  # Check if prepare4lab.run is readable
  if [ ! -r /home/pi/.mentor/prepare4lab.run ]; then
    echo "Error: /home/pi/.mentor/prepare4lab.run is not readable"
    # Try to fix permissions
    chmod 644 /home/pi/.mentor/prepare4lab.run || { echo "Error: failed to make prepare4lab.run readable"; exit 1; }
  fi
  
  # Append prepare4lab.run
  cat /home/pi/.mentor/prepare4lab.run >> /home/pi/.profile || { echo "Error: failed to append contents of prepare4lab.run"; exit 1; }
  
  # Convert line endings
  dos2unix /home/pi/.profile 2>/dev/null || { 
    echo "Warning: dos2unix failed, trying alternative method for line ending conversion"
    sed -i 's/\r$//' /home/pi/.profile || { echo "Error: failed to convert line endings in .profile"; exit 1; }
  }
  
  echo "Profile setup completed successfully"
}

test_network() {
  echo "Testowanie polaczenia sieciowego..."
  
  # Check IP assignment
  ip_address=$(hostname -I | awk '{print $1}') || { echo "Error: failed to get hostname IP"; exit 1; }
  local ierr
  ierr=0
  if [ -z "$ip_address" ]; then
    echo "Warning: No IP address detected"
    ierr=1
  else
    echo "IP address detected: $ip_address"
  fi
  
  # Test internet connectivity only if we have an IP
  if [ $ierr -eq 0 ]; then
    echo "Testing connection to www.mentorpolska.pl..."
    if ping -c 3 -W 5 www.mentorpolska.pl >/dev/null 2>&1; then
      echo "Internet connectivity verified"
    else
      echo "Warning: Cannot reach www.mentorpolska.pl"
      
      # Try alternative site
      echo "Testing connection to google.com..."
      if ping -c 3 -W 5 google.com >/dev/null 2>&1; then
        echo "Internet connectivity verified through alternative site"
        ierr=0
      else
        echo "Warning: Cannot reach google.com"
        ierr=1
      fi
    fi
  fi
  
  if [ $ierr -eq 0 ]; then
    echo "Polaczenie z Internetem nawiazane."
    echo ""
    echo "Proces moze zajac kilka minut, a urzadzenie moze zostac uruchomione ponownie kilka razy."
    echo "Nie wylaczaj zasilania."
    echo "Nie odlaczaj internetu."
    echo "Oczekuj instrukcji."
  else
    echo "Nie wykryto polaczenia z internetem: ierr $ierr"
    
    # Check network interface status
    echo "Network interface status:"
    ip addr show || echo "Failed to get network interface status"
    
    if [ "$user" -ne 1 ]; then
      echo "Trying to configure DHCP automatically..."
      local dhcpcd_conf
      dhcpcd_conf=$(cat <<-EOF
# plik fallback
# See dhcpcd.conf(5) for details.

hostname
clientid
persistent
option rapid_commit
option domain_name_servers, domain_name, domain_search, host_name
option classless_static_routes
option interface_mtu
require dhcp_server_identifier
slaac private

# DHCP ON
auto lo
iface lo itet loopback
iface eth0 inet dhcp
EOF
      )
      
      # Backup existing config if it exists
      if [ -f /etc/dhcpcd.conf ]; then
        cp /etc/dhcpcd.conf /etc/dhcpcd.conf.mentorbak || { echo "Error: failed to backup /etc/dhcpcd.conf"; exit 1; }
        echo "Created backup of existing dhcpcd.conf"
      fi
      
      echo "$dhcpcd_conf" > /etc/dhcpcd.conf || { echo "Error: failed to write to /etc/dhcpcd.conf"; exit 1; }
      echo "Konfiguracja DHCP zapisana do /etc/dhcpcd.conf"
      echo "Skrypt bedzie musial zostac uruchomiony jeszcze raz."
      echo "Restart za 5 sekund..."
      sleep 5
      rere
    fi
  fi
}

main() {
  wait_apt

  if [ "$(id -u)" -ne 0 ]; then
		echo "This script must be run as root. Please use sudo."
		exit 1
  fi

  directory_path=/home/pi/.mentor

  if [ ! -d $directory_path ]; then
		mkdir -p $directory_path || { echo "Error: failed to create directory $directory_path"; exit 1; }
  fi

  if [ $clear -eq 1 ]; then
    echo "CLEARING STEP FILE"
    rm -fr /home/pi/.prepare4lab.step || { echo "Error: failed to remove /home/pi/.prepare4lab.step"; exit 1; }
		set_step 0
  else
		file_content=$(<"/home/pi/.prepare4lab.step")
		if echo "$file_content" | grep -Eq '^[0-9]+$'; then
		  echo "GOT STEP FILE: $file_content"
      set_step "$file_content"
		else
			if [ $user -eq 1 ]; then
			  echo "FIRST RUN, USER MODE"
        set_step 0
			else
				echo "Nieznany stan pulpitu. Dziwna zawartosc pliku /home/pi/.prepare4lab.step:"
				echo "$file_content"
        set_step 0
			fi
		fi
  fi

  echo_dbg "Krok: $step"

  # Show final job configuration
  echo_dbg "Job: $job ${args_string}"

  if [ "$step" -ne 0 ]; then
    if [ "$step" -eq 5 ]; then
      echo_dbg "Pulpit jest juz oznaczony jako przygotowany."
      if [ $user -eq 1 ]; then
        echo "RESET BY USER"
        set_step 0
      else
        exit 0
      fi
    elif [ "$step" -eq 1 ] || [ "$step" -eq 2 ] || [ "$step" -eq 3 ] || [ "$step" -eq 4 ]; then
      echo_dbg "Pulpit oznaczony jako w trakcie przygotowywania."
    else
      echo_dbg "Nieznany stan pulpitu."
      if [ $user -eq 1 ]; then
        echo "RESET BY USER"
        set_step 0
      else
        exit 1
      fi
    fi
  fi
  
  if  [ "$prep" -eq 1 ]; then
    step=0
  fi
  
  if [ "$step" -eq 0 ]; then
    step0 "$1"
  elif [ "$step" -eq 1 ]; then
    step1
  elif [ "$step" -eq 2 ]; then
    step2
  elif [ "$step" -eq 3 ]; then
    step3
  elif [ "$step" -eq 4 ]; then
    step4
  else
    echo "Step $step is not implemented."
    echo "Console failed to prepare for AudytorLAB."
    exit 1
  fi
}

step0() {
  echo "Przygotowywanie pulpitu AudytorLAB (1/5)..."
  pkill -f student4lab || true
  
  test_network

  if [ "$user" -eq 1 ]; then
      wait_apt
      DEBIAN_FRONTEND=noninteractive apt-get -y --allow-releaseinfo-change update || { echo "Error: failed to update apt-get"; exit 1; }
      wait_apt
      apt-get update || { echo "Error: failed to update apt-get"; exit 1; }
  
      wait_apt
      if [ "$dbg" -eq 1 ]; then
          DEBIAN_FRONTEND=noninteractive apt-get -y full-upgrade || { echo "Error: failed to full-upgrade apt-get"; exit 1; }
      else 
          DEBIAN_FRONTEND=noninteractive apt-get -y upgrade || { echo "Error: failed to upgrade apt-get"; exit 1; }
      fi
  
      wait_apt
      DEBIAN_FRONTEND=noninteractive apt-get -y autoremove || { echo "Error: failed to autoremove apt-get"; exit 1; }
      wait_apt
      DEBIAN_FRONTEND=noninteractive apt-get -y clean || { echo "Error: failed to clean apt-get"; exit 1; }
  
      wait_apt
  fi
  
  wait_apt
  DEBIAN_FRONTEND=noninteractive apt-get -y install \
  # installer4lab deps

  if [ "$devel" -eq 1 ]; then
      wait_apt
      DEBIAN_FRONTEND=noninteractive apt-get -y install \
      # installer4lab devps
  fi
  
  new_profile
  
  if [ $prep -eq 1 ] || [ $user -eq 1 ]; then
    wait_apt
    local po
    po=""
    if [ $devel -eq 1 ]; then
      po=" devel"
    fi
    bash -c "/home/pi/.mentor/preinstall.sh$po" 2>&1 | tee /home/pi/.mentor/preinstall_output.log
    
    echo "Podsumowanie preinstall.sh:"
    cat /home/pi/.mentor/preinstall_output.log
    echo "-- Koniec podsumowania preinstall.sh --"
    
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
        echo "Error occurred during preinstall.sh execution. Check /tmp/preinstall_output.log for details."
        exit 1
    fi
    echo "Preinstall.sh executed successfully."
    touch /home/pi/.mentor/.prepared
    if [ $prep -eq 1 ]; then
      exit 0
    fi
  fi
  echo "Przygotowywanie pulpitu AudytorLAB..."
  
  create_files || { echo "Error: failed to create files"; exit 1; }
  
  echo "Configuring auto-login..."
  
  mkdir -p /etc/systemd/system/getty@tty1.service.d || { echo "Error: failed to create /etc/systemd/system/getty@tty1.service.d"; exit 1; }

  echo "[Service]
  ExecStart=
  ExecStart=-/sbin/agetty --autologin pi --noclear %I \$TERM" > /etc/systemd/system/getty@tty1.service.d/autologin.conf
  
  cp -rf /etc/sudoers /etc/sudoers.mentorbak || { echo "Error: failed to backup sudoers file"; exit 1; }

  sed -i 's/%sudo\s\+ALL=(ALL:ALL)\s\+ALL/%sudo ALL=(ALL) NOPASSWD: ALL/' /etc/sudoers

  if visudo -c; then
    true
  else
    echo "Error in sudoers file. Restoring the original file."
    mv -f /etc/sudoers.mentorbak /etc/sudoers || { echo "Error: failed to restore sudoers file"; exit 1; }
    exit 1
  fi

  passwd -d pi || { echo "Error: failed to delete password for user pi"; exit 1; }
  systemctl set-default multi-user.target || { echo "Error: failed to set default target"; exit 1; }
  
  echo "Auto-login configured"
  
  if [ $user -eq 1 ]; then
		set_step 1
    rere
  elif [ $prep -ne 1 ]; then
		set_step 2
		rere
  fi

		  # If we get here, no reboot was performed
		  echo "Manual mode completion"
		  echo "Job: $job ${args_string}"
}

step12() {
  echo "Przygotowywanie pulpitu AudytorLAB (time-travelling 2/5)..."
  
  # Stop SSH service
  systemctl stop ssh || { echo "Error: failed to stop ssh"; exit 1; }
  
  # Create SSH directory if it doesn't exist
  if [ ! -d /ssh ]; then
    mkdir -p /ssh || { echo "Error: failed to create /ssh directory"; exit 1; }
  fi

  # Ensure .ssh directory exists for the pi user
  if [ ! -d /home/pi/.ssh ]; then
    mkdir -p /home/pi/.ssh || { echo "Error: failed to create /home/pi/.ssh directory"; exit 1; }
    chown pi:pi /home/pi/.ssh || { echo "Error: failed to set ownership of /home/pi/.ssh"; exit 1; }
  fi

  # Back up SSH configuration files before modification
  echo "Backing up SSH configuration files..."
  if [ -f /etc/ssh/ssh_config ]; then
    cp /etc/ssh/ssh_config /etc/ssh/ssh_config.mentorbak || echo "Warning: failed to backup ssh_config"
  fi
  
  if [ -f /etc/ssh/sshd_config ]; then
    cp /etc/ssh/sshd_config /etc/ssh/sshd_config.mentorbak || echo "Warning: failed to backup sshd_config"
  fi
  
  if [ -f /home/pi/.ssh/authorized_keys ]; then
    cp /home/pi/.ssh/authorized_keys /home/pi/.ssh/authorized_keys.mentorbak || echo "Warning: failed to backup authorized_keys"
  fi
  
  # Set correct permissions for SSH files and directories
  chown_chmod 700 /home/pi/.ssh
  
  # Check if id_rsa file exists before trying to set permissions
  if [ -f /home/pi/.ssh/id_rsa ]; then
    chown_chmod 600 /home/pi/.ssh/id_rsa
  else
    echo "Warning: /home/pi/.ssh/id_rsa not found, skipping permission setting"
  fi
  
  # Check if id_rsa.pub file exists before trying to set permissions
  if [ -f /home/pi/.ssh/id_rsa.pub ]; then
    chown_chmod 644 /home/pi/.ssh/id_rsa.pub
  else
    echo "Warning: /home/pi/.ssh/id_rsa.pub not found, skipping permission setting"
  fi
  
  # Set permissions on SSH configuration directories
  chmod 755 /etc/ssh || { echo "Error: failed to change permissions of /etc/ssh"; exit 1; }
  chmod 644 /etc/ssh/ssh_config || { echo "Error: failed to change permissions of /etc/ssh/ssh_config"; exit 1; }
  chmod 644 /etc/ssh/sshd_config || { echo "Error: failed to change permissions of /etc/ssh/sshd_config"; exit 1; }
  
  # Check if ssh_host_rsa_key.pub exists before setting permissions
  if [ -f /etc/ssh/ssh_host_rsa_key.pub ]; then
    chmod 600 /etc/ssh/ssh_host_rsa_key.pub || { echo "Error: failed to change permissions of /etc/ssh/ssh_host_rsa_key.pub"; exit 1; }
  else
    echo "Warning: /etc/ssh/ssh_host_rsa_key.pub not found, skipping permission setting"
  fi

  # Prepare authorized_keys file
  if [ -f /home/pi/.ssh/authorized_keys ]; then
    echo "[DEBUG] original /home/pi/.ssh/authorized_keys:"
    cat /home/pi/.ssh/authorized_keys
  else
    echo "[DEBUG] No existing authorized_keys file found."
  fi
  
  # Remove and recreate authorized_keys file
  rm -f /home/pi/.ssh/authorized_keys || { echo "Error: failed to remove /home/pi/.ssh/authorized_keys"; exit 1; }
  touch /home/pi/.ssh/authorized_keys || { echo "Error: failed to create /home/pi/.ssh/authorized_keys"; exit 1; }
  chown pi:pi /home/pi/.ssh/authorized_keys || { echo "Error: failed to set ownership of authorized_keys"; exit 1; }
  
  # Add SSH keys
  local authorized_keys
  authorized_keys=$(cat <<-EOF
# installer4lab id_ed25519.pub
EOF
  )
  echo "$authorized_keys" >> /home/pi/.ssh/authorized_keys || { echo "Error: failed to write to /home/pi/.ssh/authorized_keys"; exit 1; }
  cp /home/pi/.ssh/authorized_keys /home/pi/.ssh/authorized_keys.mentorbak || echo "Warning: failed to backup authorized_keys"
  echo "[DEBUG] authorized_keys after appending id_ed25519.pub:"
  cat /home/pi/.ssh/authorized_keys
  
  # Add id_rsa.pub key if it exists
  if [ -f /home/pi/.ssh/id_rsa.pub ]; then
    cat /home/pi/.ssh/id_rsa.pub >> /home/pi/.ssh/authorized_keys || { echo "Error: failed to append /home/pi/.ssh/id_rsa.pub"; exit 1; }
    echo "[DEBUG] /home/pi/.ssh/authorized_keys after appending /home/pi/.ssh/id_rsa.pub:"
    cat /home/pi/.ssh/authorized_keys
  else
    echo "Warning: /home/pi/.ssh/id_rsa.pub not found, skipping"
  fi
  
  # Check if known_keys directory exists
  if [ -d /home/pi/.mentor/known_keys ]; then
    # Add all public keys from known_keys directory
    for pub_file in /home/pi/.mentor/known_keys/*; do
      if [ -f "$pub_file" ]; then
        cat "$pub_file" >> /home/pi/.ssh/authorized_keys || { echo "Error: failed to append $pub_file to authorized_keys"; exit 1; }
        echo "[DEBUG] /home/pi/.ssh/authorized_keys after appending ($pub_file):"
        cat /home/pi/.ssh/authorized_keys
      fi
    done
  else
    echo "Warning: /home/pi/.mentor/known_keys directory not found, skipping"
  fi
  
  echo "[DEBUG] /home/pi/.ssh/authorized_keys after appending (2):"
  cat /home/pi/.ssh/authorized_keys
  
  # Create known_hosts file
  if [ -f /home/pi/.ssh/known_hosts ]; then
    echo "[DEBUG] /home/pi/.ssh/known_hosts before appending:"
    cat /home/pi/.ssh/known_hosts
    cp -f /home/pi/.ssh/known_hosts /home/pi/.ssh/known_hosts.mentorbak || echo "Warning: failed to backup known_hosts"
    rm -f /home/pi/.ssh/known_hosts || { echo "Error: failed to remove known_hosts"; exit 1; }
  fi
  
  touch /home/pi/.ssh/known_hosts || { echo "Error: failed to create known_hosts"; exit 1; }
  
  # Process authorized_keys to create known_hosts
  if [ -s /home/pi/.ssh/authorized_keys ]; then
    while IFS= read -r line; do
      # Skip comment lines
      if [[ "$line" == \#* ]]; then
        continue
      fi
      if [[ -n "$line" ]]; then
        line_without_first_and_last_word=$(echo "$line" | awk '{$1=""; $NF=""; print $0}' | xargs)
        echo "$HOST $line_without_first_and_last_word"
      fi
    done < /home/pi/.ssh/authorized_keys > /home/pi/.ssh/known_hosts || { echo "Error: failed to create known_hosts"; exit 1; }
  else
    echo "Warning: authorized_keys is empty, known_hosts will be empty too"
  fi
  
  # Set correct permissions for known_hosts and authorized_keys
  chown_chmod 644 /home/pi/.ssh/known_hosts
  chown_chmod 600 /home/pi/.ssh/authorized_keys

  # Enable SSH service
  systemctl enable ssh || { echo "Error: failed to enable ssh"; exit 1; }
  
  echo "SSH configuration completed successfully"

  PROTOCOL=TCP
  HIDE_CURSOR=1
  MAXIMIZE=1
  ACK_RETRY=3
  ACK_WAIT=3000
  PING=10000
  PING_MISS=3
  LNR_ADD=1
  LNR_SWAP=0
  MENU_TIMER=1500
  SERIAL=ttyAMA0

  pairs="MIC_TYPE $MIC_TYPE DEBUG_LEVEL $DEBUG_LEVEL HOST $HOST VER_APP $VER_APP VER_LIB $VER_LIB PORT $PORT PROTOCOL $PROTOCOL HIDE_CURSOR $HIDE_CURSOR MAXIMIZE $MAXIMIZE ACK_RETRY $ACK_RETRY ACK_WAIT $ACK_WAIT PING $PING PING_MISS $PING_MISS LNR_ADD $LNR_ADD LNR_SWAP $LNR_SWAP MENU_TIMER $MENU_TIMER USERNAME pi SERIAL $SERIAL"
  sudo -u pi mkdir -p /home/pi/.config/Mentor || { echo "Error: failed to create /home/pi/.config/Mentor"; exit 1; }
  rm -rf /home/pi/.config/Mentor/AudytorStudent.conf || { echo "Error: failed to remove /home/pi/.config/Mentor/AudytorStudent.conf"; exit 1; }
  sudo -u pi touch /home/pi/.config/Mentor/AudytorStudent.conf || { echo "Error: failed to create /home/pi/.config/Mentor/AudytorStudent.conf"; exit 1; }
  sudo -u pi echo "[General]" | tee /home/pi/.config/Mentor/AudytorStudent.conf

  echo "$pairs" | tr ' ' '\n' | while read -r key; do
    read -r value
    echo "$key=$value" | tee -a /home/pi/.config/Mentor/AudytorStudent.conf
  done
}

step1() {
  echo "Przygotowywanie pulpitu AudytorLAB (3/5)..."
  step12  
  set_step 3
  clear
  echo "Ponowne uruchomienie pulpitu powinno zostac wykonane juz w sieci docelowej."
  echo "Zapisz ten moment na karte do sklonowania po dokonaniu ewentualnych zmian." 
  echo ""
  echo "Wtrzymaj przygotowywanie pulpitu: touch /home/pi/.mentor/wait.marker"
  echo "Kontynuuj przygotowywanie pulpitu: reboot"
  exit 0
}

step2() {
  echo "Przygotowywanie pulpitu AudytorLAB (4/5)..."
  step12
  step3
}

step3() {
  if [ -f /home/pi/.mentor/wait.marker ]; then
    clear
    echo "Ponowne uruchomienie pulpitu powinno zostac wykonane juz w sieci docelowej."
    echo "Zapisz ten moment na karte do sklonowania po dokonaniu ewentualnych zmian."
    echo "Kontynuuj przygotowywanie pulpitu: rm -f /home/pi && reboot"
    exit 0
  fi
  
  echo "Przygotowywanie pulpitu AudytorLAB (5/5)..."
  local ip_address
  ip_address=$(hostname -I | awk '{print $1}')
  local new_hostname
  new_hostname=rpi$(echo "$ip_address" | tr -d '.')
  
  usermod -a -G dialout pi
  usermod -a -G tty pi
  usermod -a -G video pi

  set_step 4
  
  echo "PONOWNE URUCHOMIENIE ZA MINUTE"
  shutdown -r +1 >/dev/null 2>&1 || { echo "Error: failed to schedule restart"; exit 1; }
  
  # Get current hostname for comparison
  current_hostname=$(hostname)
  echo "Current hostname: $current_hostname"
  echo "New hostname: $new_hostname"
  
  # Update hostname with error handling
  echo "$new_hostname" > /etc/hostname || { 
    echo "Error: failed to set hostname to $new_hostname";
    exit 1; 
  }
  
  # Create hosts file backup
  cp /etc/hosts /etc/hosts.mentorbak || { 
    echo "Error: failed to backup /etc/hosts"; 
    exit 1; 
  }
  
  # Update hosts file with error handling
  sed -i "s/127.0.1.1.*/127.0.1.1 $new_hostname/" /etc/hosts || { 
    echo "Error: failed to update hostname in /etc/hosts"; 
    cp /etc/hosts.mentorbak /etc/hosts;  # Restore backup
    exit 1; 
  }
  
  # Verify the changes
  if ! grep -q "$new_hostname" /etc/hostname; then
    echo "Error: hostname not set correctly in /etc/hostname"
    exit 1
  fi
  
  if ! grep -q "127.0.1.1.*$new_hostname" /etc/hosts; then
    echo "Error: hostname not set correctly in /etc/hosts"
    exit 1
  fi
  
  echo "Hostname successfully set to $new_hostname"
}

step4() {
  # Get IP address with error handling
  local ip_address
  ip_address=$(hostname -I | awk '{print $1}') || {
    echo "Error: Failed to get IP address"
    ip_address="unknown"
  }
  
  local current_hostname
  current_hostname=$(hostname)
  
  # Create a marker file with collected system information
  create_marker_file "/home/pi/.mentor" "prepare4lab.marker" "$(collect_system_info)"
  
  # Set final step
  set_step 5
  
  exit 0
}
  
# Function to create a marker file similar to the C# version
create_marker_file() {
  local marker="$1"
  local filename="$2"
  local lines_to_append="$3"
  
  if [[ ! "$marker" == *.marker ]]; then
    if [[ -z "$filename" ]]; then
      filename="$(basename "$marker" | tr '[:upper:]' '[:lower:]').marker"
    fi
    marker="${marker}/${filename}"
  fi
  
  echo_dbg "Creating marker file: $marker"
  filename="$(basename "$marker")"
  
  local timestamp
  timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
  local username
  username="$(whoami)"
  local hostname
  hostname="$(hostname)"
  
  # Create parent directory if it doesn't exist
  mkdir -p "$(dirname "$marker")" || { 
    echo "Error: failed to create directory for marker file"; 
    return 1; 
  }

  # Write initial marker content
  {
    echo "# $filename"
    echo "WERSJA=$WERSJA"
    echo "# "
    echo "# $timestamp"
    echo "# ${username}@${hostname}"
    if [[ -n "$HOST" && "$HOST" != "0.0.0.0" ]]; then
      echo "# ${HOST}:${PORT}"
    fi
    echo "# ---"
    echo "# "
  } > "$marker" || {
      echo "Error: failed to write to marker file"; 
      return 1;
  }
  
  # Append additional lines if provided
  if [[ -n "$lines_to_append" ]]; then
    echo "$lines_to_append" >> "$marker" || {
      echo "Error: failed to append to marker file"; 
      return 1;
    }
  fi
  
  # Add footer
  {
    echo "# ---"
    echo "# "
  } >> "$marker" || {
    echo "Error: failed to write footer to marker file"; 
    return 1;
  }
  
  return 0
}

# Collect system information to append to the marker file
collect_system_info() {
  echo "# =========================================================="
  echo "# SYSTEM INFORMATION"
  echo "# =========================================================="
  echo "# "
  echo "# Kernel Information:"
  echo "# ------------------"
  echo "# $(uname -a)"
  echo "# "
  echo "# OS Information:"
  echo "# --------------"
  echo "# Debian Version: $(cat /etc/debian_version 2>/dev/null || echo 'unknown')"
  echo "# LSB Release:"
  if command -v lsb_release >/dev/null 2>&1; then
    lsb_release -a 2>/dev/null | sed 's/^/# /'
  else
    echo "# LSB Release information not available"
  fi
  echo "# "
  
  echo "# Hostname & Network Information:"
  echo "# ------------------------------"
  echo "# Hostname: $(hostname)"
  echo "# Domain Name: $(hostname -d 2>/dev/null || echo 'N/A')"
  echo "# Fully Qualified Domain Name: $(hostname -f 2>/dev/null || echo 'N/A')"
  echo "# Primary IP: $(hostname -I | awk '{print $1}')"
  echo "# All IPs: $(hostname -I)"
  echo "# "
  
  echo "# Network Interfaces:"
  echo "# ------------------"
  ip -br addr show | while read -r line; do
    echo "# $line"
  done
  echo "# "
  
  echo "# Routing Table:"
  echo "# -------------"
  ip route | sed 's/^/# /'
  echo "# "
  
  echo "# DNS Settings:"
  echo "# ------------"
  if [ -f /etc/resolv.conf ]; then
    grep -v "^#" /etc/resolv.conf | sed 's/^/# /'
  else
    echo "# resolv.conf not found"
  fi
  echo "# "
  
  echo "# Hardware Information:"
  echo "# -------------------"
  echo "# CPU:"
  lscpu | grep "Model name\|Architecture\|CPU(s)\|CPU MHz" | sed 's/^/# /'
  echo "# "
  
  echo "# Memory Information:"
  echo "# -----------------"
  free -h | sed 's/^/# /'
  echo "# "
  
  echo "# Storage Information:"
  echo "# ------------------"
  echo "# Root Filesystem:"
  df -h / | sed 's/^/# /'
  echo "# "
  echo "# All Mounted Filesystems:"
  df -h | sed 's/^/# /'
  echo "# "
  
  echo "# Installed Packages Information:"
  echo "# -----------------------------"
  echo "# Qt Version: $(dpkg -s libqt5core5a 2>/dev/null | grep '^Version:' | awk '{print $2}' || echo 'not installed')"
  
  # Check for common packages that might be important
  for pkg in python3 gcc g++ make openssl libssl-dev openssh-server openssh-client; do
    version=$(dpkg -s $pkg 2>/dev/null | grep '^Version:' | awk '{print $2}' || echo 'not installed')
    echo "# $pkg: $version"
  done
  echo "# "
  
  echo "# Service Status:"
  echo "# -------------"
  for service in ssh dhcpcd networking cron systemd-timesyncd; do
    status=$(systemctl is-active $service 2>/dev/null || echo "inactive")
    echo "# $service: $status"
  done
  echo "# "
  
  echo "# System Uptime:"
  echo "# ------------"
  uptime | sed 's/^/# /'
  echo "# "
  
  echo "# Environment Variables:"
  echo "# --------------------"
  echo "# PATH: $PATH"
  echo "# USER: $USER"
  echo "# HOME: $HOME"
  echo "# SHELL: $SHELL"
  echo "# "
  
  echo "# Date and Time:"
  echo "# ------------"
  echo "# Current Time: $(date)"
  echo "# Timezone: $(cat /etc/timezone 2>/dev/null || echo 'unknown')"
  echo "# "
  
  echo "# =========================================================="
}

main "$@"