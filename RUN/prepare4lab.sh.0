#!/usr/bin/env bash
# -*- coding: utf-8 -*-
WERSJA=0.7.7
show_help() {
    cat << EOF
===============================================================================
 prepare4lab.sh v$WERSJA - Mentor Lab Preparation Utility
===============================================================================
 Usage: sudo $0 [job] [options]
 Job Type (required):
   prepare
   install              tylko to!
   setup
Options:
   --devel              gdy student4lab ze zrodel
   --debug              wiecej widac, czeka
   --quick              w ogole nie czeka
   --remote             via SSH
   --mic                dynamiczny

   --continue           nie zaczynaj od nowa, dla 'install'
   --student [Nr] [IP]  dla 'setup'
 Example:
   sudo $0 install --devel --quick
===============================================================================
EOF
}
job=""
debug=0
devel=0
quick=0
user=1
clear=1
mic=0
student_nr=0
student_ip="0.0.0.0"
prep=0
stp=0
step=9
args_string=""
# from vars!:
HOST="0.0.0.0"
PORT=0
# from vars! todo:
SWAP_SIZE_DEVEL=4096
SWAP_SIZE_RELEASE=2048
# installer4lab vars
if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 0
fi
echo_error() {
  if [ "$message" != "set_step" ]; then
    set_step 6
  fi
  local lineno="$1"
  local message="$2"
  echo "[BŁĄD@$lineno] $message"
  exit 1
}
if [ $# -gt 0 ]; then
    job="$1"
    shift
    original_args=("$job")
    while [ $# -gt 0 ]; do
        original_args+=("$1")
        case "$1" in
            --devel)
                devel=1
                ;;
            --debug)
                debug=1
                ;;
            --quick)
                quick=1
                ;;
            --remote)
                user=0
                ;;
            --continue)
                clear=0
                ;;
            --mic)
                mic=1
                ;;
            --student)
                shift
                student_nr="${1:-}"
                shift
                student_ip="${1:-}"
                echo "$student_nr" | grep -Eq '^[0-9]+$' || echo_error $LINENO "1 $student_nr"
                echo "$student_ip" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || echo_error $LINENO "2 $student_ip"
                ;;
            *)
                ;;
        esac
        shift
    done
    if [ "$job" = "prepare" ]; then
        prep=1
    elif [ "$job" = "install" ]; then
        true
    elif [ "$job" = "setup" ]; then
        stp=1
    fi
    args_string=""
    for arg in "${original_args[@]:1}"; do
        args_string="$args_string $arg"
    done
else
    show_help
    echo_error $LINENO "3 "
fi
main() {
    wait_apt
    if [ "$(id -u)" -ne 0 ]; then
        echo_stop $LINENO "Ctrl+C i nie zapomnij o sudo!"
    fi
    if [ $clear -eq 1 ]; then
        rm -fr /home/pi/.prepare4lab.step || echo_error $LINENO "Nie można usunąć pliku kroku przygotowania"
        set_step 0 || echo_error $LINENO "Nie można ustawić kroku początkowego"
    else
        if [ -f "/home/pi/.prepare4lab.step" ]; then
            file_content=$(<"/home/pi/.prepare4lab.step") || echo_error $LINENO "Nie można odczytać pliku kroku przygotowania"
            if echo "$file_content" | grep -Eq '^[0-9]+$'; then
                set_step "$file_content" || echo_error $LINENO "Nie można ustawić kroku na wartość $file_content"
            else
                set_step 0
            fi
        else
            set_step 0 || echo_error $LINENO "Nie można ustawić kroku początkowego"
        fi
    fi
    if [ $stp -eq 1 ]; then
        do_setup_noreturn # set_step 4
    else
        do_step
    fi
}
setup_student_file() {
    local filepath="$1"
    if [ "$student_ip" == "0.0.0.0" ] || [ "$student_nr" -eq 0 ]; then
        echo_error $LINENO "Brak poprawnych danych studenta: nr=$student_nr, ip=$student_ip"
    else
        if [ -f "$filepath" ]; then
            local temp_file
            temp_file=$(mktemp)
            local line
            cp "$filepath" "$filepath.lab.pre" || true
            while IFS= read -r line; do
                if [[ "$line" == *"# prepare4lab clear "* ]]; then
                    line="${line//# prepare4lab clear /}"
                fi
                if [[ "$line" == *"# prepare4lab comment"* ]]; then
                    if [[ "$line" != "#"* ]]; then
                        line="#$line"
                    fi
                fi
                line="${line//!STUDENT_IP!/$student_ip}"
                line="${line//!STUDENT_NR!/$student_nr}"
                echo "$line" >> "$temp_file"
            done < "$filepath"
            mv "$temp_file" "$filepath"
        fi
    fi
}
do_setup_noreturn() {
    sudo chmod +x /usr/local/bin/student4lab || echo_error $LINENO "Nie można ustawić uprawnień wykonywania dla student4lab"
    echo "HOSTID=$student_nr" | tee -a /home/pi/.config/Mentor/AudytorStudent.conf || echo_error $LINENO "Nie można dodać HOSTID do pliku konfiguracyjnego"
    setup_student_file /etc/dhcpcd.conf
    set_step 4
    set_hostname_noreturn "rpi$student_nr"
}
do_step() {
    if [ "$step" -ne 0 ]; then
        if [ "$step" -eq 4 ] || [ "$step" -eq 9 ] || [ "$step" -eq 6 ]; then
            if [ "$user" -eq 1 ]; then
                set_step 0
            else
                exit 0
            fi
        elif [ "$step" -eq 1 ] || [ "$step" -eq 2 ] || [ "$step" -eq 3 ]; then
            true
        else
            if [ "$user" -eq 1 ]; then
                set_step 0
            else
                echo_error $LINENO "Nieprawidłowy krok: $step dla trybu zdalnego"
            fi
        fi
    fi
    local next_step=$((step + 1))
    local dodere=1
    if [ "$step" -eq 0 ]; then
        if [ "$prep" -eq 1 ] || [ "$user" -eq 1 ]; then
            prepare # non-destructive
            if [ "$user" -eq 1 ]; then
                next_step=1
            else
                echo_error $LINENO "Niedozwolona kombinacja: tryb zdalny z krokiem $step"
            fi
        fi
        step0 # setup
    elif [ "$step" -eq 1 ]; then
        step1 # ssh
        if [ "$user" -eq 1 ]; then
            dodere=0
            echo_info "Następne uruchomienie już w skonfigurowanej sieci docelowej!"
            echo_info "Aby wstrzymać: \"touch ~/.mentor/wait.lab.marker\""
            echo_info "Aby wznowić: \"rm ~/.mentor/wait.lab.marker && reboot\""
            echo_wait ""
        else
            next_step=3
        fi
    elif [ "$step" -eq 2 ]; then
        if [ $user -ne 1 ]; then
            echo_error $LINENO "Krok $step niedozwolony w trybie zdalnym"
        fi
        if ask_user "Czy jesteś już w skonfigurowanej sieci docelowej"; then
            step2_noreturn # network
        else
            echo_info "Następne uruchomienie już w skonfigurowanej sieci docelowej!"
            echo_info "Aby wstrzymać: \"touch ~/.mentor/wait.lab.marker\""
            echo_info "Aby wznowić: \"rm ~/.mentor/wait.lab.marker && reboot\""
            echo_wait "Oczekiwanie na restart w nowej sieci"
            exit 0
        fi
    elif [ "$step" -eq 3 ]; then
        step3
        next_step=3
        dodere=0
    else
        echo_error $LINENO "Nieobsługiwany krok: $step"
    fi
    if [ "$next_step" -ne "$step" ]; then
        set_step "$next_step"
    fi
    if [ $dodere -eq 1 ]; then
        rere
    fi
}
prepare() {
    echo_info "Przygotowywanie systemu..."
    pkill -f student4lab || true
    directory_path=/home/pi/.mentor
    if [ ! -d "$directory_path" ]; then
        echo_info "Tworzenie katalogu .mentor"
        mkdir -p "$directory_path" || echo_error $LINENO "Nie można utworzyć katalogu .mentor"
    fi
    aptcmd=$(APT)
    echo_info "Rozpoczynanie aktualizacji systemu"
    debian_upgrade "$aptcmd"
    #systemctl disable serial-getty@ttyAMA0.service || echo "serial-getty@ttyAMA0 already disabled"
    #systemctl disable hciuart >/dev/null 2>&1 || true
    echo_info "Wyłączanie menedżera wyświetlania"
    systemctl disable lightdm >/dev/null 2>&1 || true
    echo_info "Konfiguracja pamięci wymiany"
    setup_swap
    echo_info "Przygotowanie systemu zakończone"
}
step0() {
    echo_info "Krok 0: Konfiguracja podstawowa"
    echo_info "Tworzenie plików konfiguracyjnych"
    create_files
    echo_info "Dodawanie użytkownika pi do wymaganych grup"
    usermod -a -G dialout pi || echo_error $LINENO "Nie można dodać użytkownika pi do grupy dialout"
    usermod -a -G tty pi || echo_error $LINENO "Nie można dodać użytkownika pi do grupy tty"
    usermod -a -G video pi || echo_error $LINENO "Nie można dodać użytkownika pi do grupy video"
    wait_apt
    echo_info "Konfiguracja automatycznego uruchamiania"
    setup_autostart
    echo_info "Krok 0 zakończony pomyślnie"
}
step1() { # SSH
    echo_info "Krok 1: Konfiguracja SSH"
    echo_info "Zatrzymywanie usługi SSH"
    systemctl stop ssh || echo_error $LINENO "Nie można zatrzymać usługi SSH"
    if [ ! -d "/ssh" ]; then
        echo_info "Tworzenie katalogu /ssh"
        mkdir -p /ssh || echo_error $LINENO "Nie można utworzyć katalogu /ssh"
    fi
    if [ ! -d /home/pi/.ssh ]; then
        echo_info "Tworzenie katalogu .ssh"
        mkdir -p /home/pi/.ssh || echo_error $LINENO "Nie można utworzyć katalogu .ssh"
        chown pi:pi /home/pi/.ssh || echo_error $LINENO "Nie można zmienić właściciela katalogu .ssh"
    fi
    echo_info "Tworzenie kopii zapasowych plików konfiguracyjnych SSH"
    create_backup_if_needed /etc/ssh/ssh_config
    create_backup_if_needed /etc/ssh/sshd_config
    create_backup_if_needed /home/pi/.ssh/authorized_keys
    create_backup_if_needed /home/pi/.ssh/known_hosts
    echo_info "Ustawianie uprawnień dla katalogów i plików SSH"
    chown_chmod 700 /home/pi/.ssh
    if [ -f /home/pi/.ssh/id_rsa ]; then
        chown_chmod 600 /home/pi/.ssh/id_rsa
    fi
    if [ -f /home/pi/.ssh/id_rsa.pub ]; then
        chown_chmod 644 /home/pi/.ssh/id_rsa.pub
    fi
    chmod 755 /etc/ssh || echo_error $LINENO "Nie można ustawić uprawnień dla katalogu /etc/ssh"
    chmod 644 /etc/ssh/ssh_config || echo_error $LINENO "Nie można ustawić uprawnień dla pliku ssh_config"
    chmod 644 /etc/ssh/sshd_config || echo_error $LINENO "Nie można ustawić uprawnień dla pliku sshd_config"
    if [ -f /etc/ssh/ssh_host_rsa_key.pub ]; then
        chmod 600 /etc/ssh/ssh_host_rsa_key.pub || echo_error $LINENO "Nie można ustawić uprawnień dla klucza SSH"
    fi
    rm -f /home/pi/.ssh/authorized_keys || echo_error $LINENO "Nie można usunąć pliku authorized_keys"
    touch /home/pi/.ssh/authorized_keys || echo_error $LINENO "Nie można utworzyć pliku authorized_keys"
    chown pi:pi /home/pi/.ssh/authorized_keys || echo_error $LINENO "Nie można zmienić właściciela pliku authorized_keys"
    local authorized_keys
    authorized_keys=$(cat <<-EOF
# installer4lab id_ed25519.pub
EOF
    )
    if ! echo "$authorized_keys" >> "/home/pi/.ssh/authorized_keys"; then
        echo_error $LINENO "Nie można dodać kluczy do pliku authorized_keys"
    fi
    if [ -f /home/pi/.ssh/id_rsa.pub ]; then
        cat /home/pi/.ssh/id_rsa.pub >> /home/pi/.ssh/authorized_keys || echo_error $LINENO "Nie można dodać klucza publicznego do authorized_keys"
    fi
    if [ -d /home/pi/.mentor/known_keys ]; then
        key_count=0
        for pub_file in /home/pi/.mentor/known_keys/*; do
            if [ -f "$pub_file" ]; then
                cat "$pub_file" >> /home/pi/.ssh/authorized_keys || echo_error $LINENO "Nie można dodać klucza $pub_file do authorized_keys"
                key_count=$((key_count + 1))
            fi
        done
    fi
    if [ -f /home/pi/.ssh/known_hosts ]; then
        rm -f /home/pi/.ssh/known_hosts || echo_error $LINENO "Nie można usunąć pliku known_hosts"
    fi
    touch /home/pi/.ssh/known_hosts || echo_error $LINENO "Nie można utworzyć pliku known_hosts"
    if [ -s /home/pi/.ssh/authorized_keys ]; then
        local line_count=0
        while IFS= read -r line; do
            if [[ "$line" == \#* ]]; then
                continue
            fi
            if [[ -n "$line" ]]; then
                trimmed=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                after_first_removal="${trimmed#* }"
                line_without_first_and_last_word="${after_first_removal% *}"
                echo "$line_without_first_and_last_word"
                line_count=$((line_count + 1))
            fi
        done < /home/pi/.ssh/authorized_keys > /home/pi/.ssh/known_hosts || echo_error $LINENO "Nie można przetworzyć kluczy do pliku known_hosts"
    fi
    chown_chmod 644 /home/pi/.ssh/known_hosts || echo_error $LINENO "Nie można ustawić uprawnień dla pliku known_hosts"
    chown_chmod 600 /home/pi/.ssh/authorized_keys || echo_error $LINENO "Nie można ustawić uprawnień dla pliku authorized_keys"
    systemctl enable ssh || echo_error $LINENO "Nie można włączyć usługi SSH"
    return 0
}
step2_noreturn() { # final LAN
    echo_info "Krok 2: Konfiguracja sieci docelowej"
    if [ -f /home/pi/.mentor/wait.lab.marker ]; then
        echo_info "Znaleziono znacznik oczekiwania - wstrzymanie działania"
        exit 0
    fi
    echo_info "Pobieranie adresu IP"
    local ip_address
    ip_address=$(hostname -I | awk '{print $1}') || echo_error $LINENO "Nie można uzyskać adresu IP"
    echo_info "Generowanie nazwy hosta na podstawie adresu IP: $ip_address"
    local new_hostname
    new_hostname=rpi$(echo "$ip_address" | cut -d'.' -f3-4 | tr -d '.')
    echo_info "Nowa nazwa hosta: $new_hostname"
    set_step 3
    set_hostname_noreturn "$new_hostname"
}
step3() {
    echo_info "Krok 3: Finalizacja konfiguracji"
    echo_info "Pobieranie adresu IP"
    local ip_address
    ip_address=$(hostname -I | awk '{print $1}') || {
        echo_error $LINENO "Nie można uzyskać adresu IP"
    }
    echo_info "Tworzenie pliku znacznika z informacjami o systemie"
    create_marker_file "/home/pi/.mentor" "prepare4lab.lab.marker" "$(collect_system_info)" || {
        echo_error $LINENO "Nie można utworzyć pliku znacznika: kod błędu $?"
    }
    clear
    cat /home/pi/.mentor/prepare4lab.lab.marker
    echo ""
    echo_wait "Mentor wita! Konfiguracja zakończona pomyślnie."
}
echo_info() {
    local msg="$1"
    echo "[INFO] $msg"
}
echo_stop() {
    local operation="$1"
    sync
    if [ "$user" -eq 1 ]; then
        echo ""
        if [ "$quick" -eq 1 ]; then
            echo "[STOP] $operation //[Enter] (7s)"
            read -t 7 -r || true
        else
            echo "[STOP] $operation"
            echo "Naciśnij [Enter] aby kontynuować, Ctrl+C aby anulować..."
            read -r
        fi
    else
        echo "[STOP] $operation"
    fi
}
echo_wait() {
    local message="$1"
    if [ "$user" -eq 1 ]; then
        echo ""
    fi
    if [[ "$user" -eq 1 || "$debug" -eq 1 ]] && [ "$quick" -eq 0 ]; then
        echo "[CZEKAJ] $message"
        read -t 1 -r || true
    else
        echo "[CZEKAJ] $message"
    fi
    return 0
}
ask_user() {
    local message="$1"
    if [ "$user" -eq 1 ] && [ "$quick" -ne 1 ]; then
        while true; do
            echo -n "$message"
            echo -n "? (t/n): "
            read -r response

            case "$response" in
                [Yy]|[Tt])
                    return 1
                    ;;
                [Nn])
                    return 0
                    ;;
                *)
                    echo "Wpisz [t] dla tak lub [n] dla nie"
                    continue
                    ;;
            esac
        done
    else
        return 1
    fi
}
set_step() {
    step=$1
    if ! [[ "$step" =~ ^[0-9]+$ ]]; then
        echo_error $LINENO "Nieprawidłowy krok: wartość musi być liczbą"
    fi
    if [ ! -d /home/pi ]; then
        echo_error $LINENO "Katalog domowy użytkownika pi nie istnieje" 
    fi
    if [ -f "/home/pi/.prepare4lab.step" ]; then
        rm -f "/home/pi/.prepare4lab.step" || echo_error $LINENO "Nie można usunąć pliku kroku przygotowania"
    fi
    echo "$step" | sudo -u pi tee /home/pi/.prepare4lab.step > /dev/null || echo_error $LINENO "Nie można zapisać kroku do pliku"
    if [ ! -f /home/pi/.prepare4lab.step ]; then
        echo_error $LINENO "Plik kroku przygotowania nie został utworzony"
    fi
    read_step=$(<"/home/pi/.prepare4lab.step") || echo_error $LINENO "Nie można odczytać zapisanego kroku przygotowania"
    if [ "$read_step" != "$step" ]; then
        echo_info "Oczekiwano kroku $step, otrzymano $read_step"
        echo_error $LINENO "Niezgodność zapisanego kroku przygotowania"
    fi
    echo_wait "KROK $step"
}
set_hostname_noreturn()
{
    local new_hostname
    new_hostname="$1"
    echo_wait "Nowa nazwa hosta: $new_hostname, restart systemu za chwilę"
    create_backup_if_needed /etc/hostname
    create_backup_if_needed /etc/hosts
    shutdown -r +1 >/dev/null 2>&1 || echo_error $LINENO "Nie można zaplanować restartu systemu"
    echo_info "Trwa zmiana nazwy hosta - nie przerywaj procesu!"
    if ! echo "$new_hostname" > "/etc/hostname"; then
        echo_error $LINENO "Nie można zapisać nowej nazwy hosta do pliku /etc/hostname"
    fi
    sed -i "s/127.0.1.1.*/127.0.1.1 $new_hostname/" /etc/hosts || {
        sudo mv -f /etc/hosts.lab.bak /etc/hosts || echo_error $LINENO "Nie można przywrócić kopii zapasowej pliku hosts: kod błędu $?";
    }
    if ! grep -q "$new_hostname" "/etc/hostname"; then
        echo_error $LINENO "Weryfikacja nazwy hosta w pliku /etc/hostname nie powiodła się"
    fi
    if ! grep -q "127.0.1.1.*$new_hostname" "/etc/hosts"; then
        echo_error $LINENO "Weryfikacja nazwy hosta w pliku /etc/hosts nie powiodła się"
    fi
    exit 0
}
wait_apt() {
    local max_wait
    max_wait=30
    if [ "$quick" -eq 1 ]; then
        max_wait=10
    fi
    local start_time
    start_time=$(date +%s)
    local current_time
    local elapsed_time

    while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; do
        current_time=$(date +%s)
        elapsed_time=$((current_time - start_time))
        if [ $((elapsed_time % 10)) -eq 0 ]; then
            echo_info "Oczekiwanie na zwolnienie blokady APT (${elapsed_time}s)"
            fuser -v /var/lib/dpkg/lock-frontend 2>/dev/null || echo_error $LINENO "Nie można sprawdzić procesu blokującego menedżer pakietów"
        fi
        if [ "$elapsed_time" -gt "$max_wait" ]; then
            pid=$(fuser /var/lib/dpkg/lock-frontend 2>/dev/null)
            if [ -n "$pid" ]; then
                                if ! ps -p "$pid" > /dev/null 2>&1; then
                    rm -f /var/lib/dpkg/lock-frontend || echo_info "Nie można usunąć blokady menedżera pakietów: $?"
                    rm -f /var/lib/dpkg/lock || echo_info "Nie można usunąć blokady dpkg: $?"
                    dpkg --configure -a || echo_info "Nie można skonfigurować pakietów: $?"
                    break
                else
                    echo_error $LINENO "Menedżer pakietów jest nadal zablokowany przez proces $pid po $max_wait sekundach"
                fi
            else
                echo_error $LINENO "Menedżer pakietów jest zablokowany, ale nie można zidentyfikować procesu po $max_wait sekundach"
            fi
        fi
        sleep 1
    done
    return 0
}
rere() {
    echo_wait "RESTART SYSTEMU"
    sync || true

    # Simplified reboot command with proper output handling
    if [ "$debug" -eq 1 ] || [ "$user" -eq 1 ]; then
        # Debug mode - show output
        shutdown -r now || systemctl reboot || echo_error $LINENO "Restart systemu nie powiódł się"
    else
        # Normal mode - suppress output
        shutdown -r now >/dev/null 2>&1 || systemctl reboot >/dev/null 2>&1 || echo_error $LINENO "Restart systemu nie powiódł się"
    fi

    # If we reach here, reboot failed
    sleep 10
    echo_error $LINENO "System nie zrestartował się poprawnie po 10 sekundach"
}
chown_chmod() {
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo_error $LINENO "Brak wymaganych parametrów uprawnień lub ścieżki"
    fi
    if [ ! -e "$2" ]; then
        if [[ "$2" == */ ]] || [[ -d "$(dirname "$2")" && ! "$(basename "$2")" =~ \. ]]; then
            mkdir -p "$2" || echo_error $LINENO "Nie można utworzyć katalogu: $2"
        else
            touch "$2" || echo_error $LINENO "Nie można utworzyć pliku: $2"
        fi
    fi
    if ! id "pi" &>/dev/null; then
        echo_error $LINENO "Użytkownik pi nie istnieje"
    fi
    chown pi:pi "$2" || echo_error $LINENO "Nie można zmienić właściciela dla: $2"
    if ! [[ "$1" =~ ^[0-7]{3}$ ]]; then
        echo_error $LINENO "Nieprawidłowy format uprawnień: $1"
    fi
    chmod "$1" "$2" || echo_error $LINENO "Nie można zmienić uprawnień dla: $2"
    local owner
    owner=$(stat -c "%U:%G" "$2" 2>/dev/null) || echo_error $LINENO "Nie można sprawdzić właściciela dla: $2"
    if [ "$owner" != "pi:pi" ]; then
        echo_error $LINENO "Nieprawidłowy właściciel: $owner dla $2"
    fi
    local perms
    perms=$(stat -c "%a" "$2" 2>/dev/null) || echo_error $LINENO "Nie można sprawdzić uprawnień dla: $2"
    if [ "$perms" != "$1" ]; then
        echo_error $LINENO "Nieprawidłowe uprawnienia: oczekiwano $1, otrzymano $perms dla $2"
    fi
    return 0
}
setup_swap() {
    local swap_size
    if [ "$devel" -eq 1 ]; then
        swap_size=$SWAP_SIZE_DEVEL
    else
        swap_size=$SWAP_SIZE_RELEASE
    fi
    if [ -z "$swap_size" ]; then
        echo_error $LINENO "Nieprawidłowy rozmiar pliku wymiany: $swap_size"
    fi
    echo_info "Konfiguracja pliku wymiany o rozmiarze $swap_size MB"
    dphys-swapfile swapoff
    if [ $swap_size -eq 0 ]; then
        systemctl disable dphys-swapfile
    else
        if ! sed -i "s/CONF_SWAPSIZE=.*/CONF_SWAPSIZE=${swap_size}/" "/etc/dphys-swapfile"; then
            echo_error $LINENO "Nie można zaktualizować rozmiaru pliku wymiany w konfiguracji"
        fi
        dphys-swapfile setup || echo_error $LINENO "Nie można skonfigurować pliku wymiany"
        systemctl enable dphys-swapfile || echo_error $LINENO "Nie można włączyć usługi pliku wymiany"
        dphys-swapfile swapon || echo_error $LINENO "Nie można aktywować pliku wymiany"
    fi
}
create_files() {
    CMDLINE_FILE="/boot/firmware/cmdline.txt"
    ROOT_PARAM=$(grep -o "root=[^ ]*" "$CMDLINE_FILE") || {
        echo_error $LINENO "76 $CMDLINE_FILE"
    }
    if [ -z "$ROOT_PARAM" ]; then
        echo_error $LINENO "77"
    fi
    echo ""
    cat "$CMDLINE_FILE"
    echo_wait "^ zawartość pliku $CMDLINE_FILE przed modyfikacją."
    # installer4lab clear generate_files
    if grep -q "root=" "$CMDLINE_FILE"; then
        echo_error $LINENO "78"
    fi
    sed -i '${/^$/d;}' "$CMDLINE_FILE" || {
        echo_error $LINENO "79 $CMDLINE_FILE"
    }
    sed -i "\$s/\$/ ${ROOT_PARAM}/" "$CMDLINE_FILE" || {
        echo_error $LINENO "80 $CMDLINE_FILE"
    }
    sed -i -e '${/^$/d;}' -e 's/[[:space:]]*$//' "$CMDLINE_FILE" || {
        echo_error $LINENO "81 $CMDLINE_FILE"
    }
    echo ""
    cat "$CMDLINE_FILE"
    echo_stop "^ zawartość pliku $CMDLINE_FILE po modyfikacji."
    mkdir -p /etc/systemd/system/getty@tty1.service.d || echo_error $LINENO "82"
    if ! echo "[Service]
        ExecStart=
        ExecStart=-/sbin/agetty --autologin pi --noclear %I \$TERM" > "/etc/systemd/system/getty@tty1.service.d/autologin.conf"; then
        echo_error $LINENO "83"
    fi
    systemctl daemon-reload
    systemctl enable getty@tty1.service
    PROTOCOL=TCP
    HIDE_CURSOR=1
    MAXIMIZE=1
    ACK_RETRY=3
    ACK_WAIT=3000
    PING=10000
    PING_MISS=3
    LNR_ADD=1
    LNR_SWAP=0
    MENU_TIMER=1500
    SERIAL=ttyAMA0
    pairs="MIC_TYPE $mic debug $debug HOST $HOST VER_APP $VER_APP VER_LIB $VER_LIB PORT $PORT PROTOCOL $PROTOCOL HIDE_CURSOR $HIDE_CURSOR MAXIMIZE $MAXIMIZE ACK_RETRY $ACK_RETRY ACK_WAIT $ACK_WAIT PING $PING PING_MISS $PING_MISS LNR_ADD $LNR_ADD LNR_SWAP $LNR_SWAP MENU_TIMER $MENU_TIMER USERNAME pi SERIAL $SERIAL"
    sudo -u pi mkdir -p /home/pi/.config/Mentor || echo_error $LINENO "84"
    rm -rf /home/pi/.config/Mentor/AudytorStudent.conf || echo_error $LINENO "85"
    sudo -u pi touch /home/pi/.config/Mentor/AudytorStudent.conf || echo_error $LINENO "86"
    sudo -u pi echo "[General]" | tee /home/pi/.config/Mentor/AudytorStudent.conf || echo_error $LINENO "87"
    local param_count=0
    echo "$pairs" | tr ' ' '\n' | while read -r key && read -r value; do  # Fixed: proper piping
        echo "$key=$value" | sudo -u pi tee -a /home/pi/.config/Mentor/AudytorStudent.conf || echo_error $LINENO "88 $key"
        param_count=$((param_count + 1))
    done
}
setup_autostart() {
    echo_info "Konfiguracja automatycznego uruchamiania"
    create_backup_if_needed /home/pi/.profile
    create_backup_if_needed /etc/sudoers
    cp -rf /etc/skel/.profile /home/pi/.profile || echo_error $LINENO "Nie można skopiować domyślnego pliku .profile"
    chown pi:pi /home/pi/.profile || echo_error $LINENO "Nie można zmienić właściciela pliku .profile"
    chmod 644 /home/pi/.profile || echo_error $LINENO "Nie można zmienić uprawnień pliku .profile"
    if [ ! -d "/home/pi/.mentor" ]; then
        echo_error $LINENO "Katalog .mentor nie istnieje"
    fi
    if [ ! -f "/home/pi/.mentor/profile.sh" ]; then
        echo_error $LINENO "Plik profile.sh nie istnieje"
    fi
    if [ ! -r /home/pi/.mentor/profile.sh ]; then
        chmod 644 /home/pi/.mentor/profile.sh || echo_error $LINENO "Nie można zmienić uprawnień pliku profile.sh"
    fi
    printf "job=%s%s --continue\n" "$job" "${args_string:+ }${args_string}" >> /home/pi/.profile || echo_error $LINENO "Nie można dodać linii job do .profile"
    if [ ! -f "/home/pi/.mentor/prepare4lab.run" ]; then
        echo_error $LINENO "Plik prepare4lab.run nie istnieje"
    fi
    echo_info "Zadanie do wykonania: $job ${args_string}"
    if [ ! -r "/home/pi/.mentor/prepare4lab.run" ]; then
        chmod 644 "/home/pi/.mentor/prepare4lab.run" || echo_error $LINENO "Nie można zmienić uprawnień pliku prepare4lab.run"
    fi
    cat /home/pi/.mentor/prepare4lab.run >> /home/pi/.profile || echo_error $LINENO "Nie można dodać zawartości prepare4lab.run do .profile"
    dos2unix /home/pi/.profile 2>/dev/null || echo_error $LINENO "Konwersja pliku .profile do formatu Unix nie powiodła się"
    echo ""
    cat /home/pi/.profile
    echo_stop "^ zawartość pliku /home/pi/.profile po modyfikacji."
    sed -i 's/%sudo\s\+ALL=(ALL:ALL)\s\+ALL/%sudo ALL=(ALL) NOPASSWD: ALL/' /etc/sudoers || echo_error $LINENO "Nie można zaktualizować pliku sudoers"
    if visudo -c; then
        echo_info "Plik sudoers jest poprawny"
    else
        sudo mv -f /etc/sudoers.lab.bak /etc/sudoers || echo_error $LINENO "Nie można przywrócić kopii zapasowej pliku sudoers"
        echo_error $LINENO "Plik sudoers zawiera błędy"
    fi
    passwd -d pi || echo_error $LINENO "Nie można usunąć hasła użytkownika pi"
    systemctl set-default multi-user.target || echo_error $LINENO "Nie można ustawić domyślnego poziomu uruchamiania"
}
test_network() {
    ip_address=$(hostname -I | awk '{print $1}') || echo_error $LINENO "Nie można uzyskać adresu IP: kod błędu $?"
    local ierr
    ierr=0
    if [ -z "$ip_address" ]; then
        echo_info "Brak adresu IP - sieć niedostępna"
        ierr=1
    fi
    if [ $ierr -eq 0 ]; then
        echo_info "Sprawdzanie połączenia sieciowego..."
        if ping -c 3 -W 5 www.mentorpolska.pl >/dev/null 2>&1; then
            echo_info "Połączenie z serwerem Mentor dostępne"
        else
            if ping -c 3 -W 5 google.com >/dev/null 2>&1; then
                echo_info "Połączenie z internetem dostępne"
                ierr=0
            else
                echo_info "Brak połączenia z internetem"
                ierr=1
            fi
        fi
    fi
    if [ $ierr -ne 0 ]; then
        return 1
    fi
    return 0
}
APT() {
    ooo="apt-get"
    if [ "$user" -eq 1 ]; then
        export DEBIAN_FRONTEND=noninteractive
        if [ "$debug" -ne 1 ]; then
            ooo="$ooo -q"
        fi
    else
        ooo="$ooo -y"
        if [ "$debug" -ne 1 ]; then
            ooo="$ooo -qq"
        fi
    fi
    echo "$ooo"
}
i4lab_create_file_before() {
  local key="$1"
  local dir
  dir="$(dirname "$key")"
  local filename
  mkdir -p "$dir"
  rm -rf "$key" || echo_error $LINENO "Nie można usunąć pliku: $key"
  touch "$key" || echo_error $LINENO "Nie można utworzyć pliku: $key"

  if [[ "$key" != /home/pi/.mentor/* ]] && [[ "$key" != /home/pi/.source4rpi/* ]]; then
    cp "$key" "$key.lab.bak" || true
  fi
}
i4lab_create_file_after() {
  local key="$1"
  dos2unix -f -k "$key" || true
  if [[ "$key" == *.sh ]]; then
    chmod +x "$key" || echo_error $LINENO "Nie można ustawić uprawnień wykonywania dla: $key"
  fi
  if [[ "$key" == /home/pi/* ]]; then
    chown pi:pi "$key" || echo_error $LINENO "Nie można zmienić właściciela dla: $key"
  fi
  echo_wait "Utworzono plik: $key"
}
create_backup_if_needed() {
    local filepath="$1"
    local backup_path="${filepath}.lab.bak"
    
    if [ -f "$backup_path" ]; then
        echo_info "Kopia zapasowa już istnieje dla $filepath, pomijanie tworzenia"
        return 0
    fi

    if [ -f "$filepath" ]; then
        echo_info "Tworzenie kopii zapasowej: $filepath -> $backup_path"
        cp "$filepath" "$backup_path" || echo_error $LINENO "Nie można utworzyć kopii zapasowej $backup_path"

        # Verify backup integrity
        if ! cmp -s "$filepath" "$backup_path"; then
            echo_error $LINENO "Weryfikacja kopii zapasowej nie powiodła się dla $backup_path"
        fi
    else
        echo_info "Plik źródłowy $filepath nie istnieje, kopia zapasowa nie jest potrzebna"
    fi
    
    return 0
}
debian_upgrade() {
    if test_network; then
        echo_info "Aktualizacja systemu..."
        if [ "$quick" -eq 1 ] && [ "$user" -eq 1 ]; then
            echo_info "Tryb szybki - pomijanie aktualizacji systemu"
        else
            aptcmd="$1"
            wait_apt
            $aptcmd --allow-releaseinfo-change update || echo_error $LINENO "Nie można zaktualizować listy pakietów"
            if ask_user "Czy zostawić środowisko graficzne"; then
                echo_info "Pozostawienie środowiska graficznego"
            else
                wait_apt || echo_error $LINENO "Oczekiwanie na dostępność menedżera pakietów nie powiodło się: $?"
                echo_info "Usuwanie środowiska graficznego"
                $aptcmd remove --purge xserver-xorg xinit
            fi

            wait_apt || echo_error $LINENO "Oczekiwanie na dostępność menedżera pakietów nie powiodło się: $?"
            if [ "$user" -eq 1 ] && ask_user "Czy pulpity są jeszcze w firmie"; then
                echo_info "Wykonywanie pełnej aktualizacji systemu"
                $aptcmd full-upgrade || echo_error $LINENO "Pełna aktualizacja systemu nie powiodła się"
                wait_apt || echo_error $LINENO "Oczekiwanie na dostępność menedżera pakietów nie powiodło się: $?"
                echo_info "Usuwanie niepotrzebnych pakietów"
                $aptcmd autoremove || echo_error $LINENO "Usuwanie niepotrzebnych pakietów nie powiodło się"
                wait_apt || echo_error $LINENO "Oczekiwanie na dostępność menedżera pakietów nie powiodło się: $?"
                echo_info "Czyszczenie pamięci podręcznej pakietów"
                $aptcmd clean || echo_error $LINENO "Czyszczenie pamięci podręcznej pakietów nie powiodło się"
            elif [ "$user" -eq 1 ] || [ "$devel" -eq 1 ]; then
                echo_info "Wykonywanie standardowej aktualizacji systemu"
                $aptcmd upgrade || echo_error $LINENO "Aktualizacja systemu nie powiodła się"
            fi
            wait_apt
            echo_info "Instalowanie wymaganych pakietów"
            $aptcmd install \
                # installer4lab deps
            if [ "$devel" -eq 1 ]; then
                wait_apt
                echo_info "Instalowanie pakietów dla trybu deweloperskiego"
                $aptcmd install \
                    # installer4lab devps
            fi
        fi
    else
        echo_info "Brak połączenia sieciowego - pomijanie aktualizacji systemu"
    fi
}
create_marker_file() {
    local marker="$1"
    local filename="$2"
    local lines_to_append="$3"
    if [ -z "$marker" ]; then
        echo_error $LINENO "Brak ścieżki dla pliku znacznika"
    fi
    if [[ ! "$marker" == *.lab.marker ]]; then
        if [[ -z "$filename" ]]; then
            filename="$(basename "$marker" | tr '[:upper:]' '[:lower:]').lab.marker"
        fi
        marker="${marker}/${filename}"
    fi
    filename="$(basename "$marker")"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')" || echo_error $LINENO "Nie można uzyskać znacznika czasu"
    local username
    username="$(whoami)" || echo_error $LINENO "Nie można uzyskać nazwy użytkownika"
    local hostname
    hostname="$(hostname)" || echo_error $LINENO "Nie można uzyskać nazwy hosta"
    local marker_dir
    marker_dir="$(dirname "$marker")"
    mkdir -p "$marker_dir" || echo_error $LINENO "Nie można utworzyć katalogu $marker_dir: kod błędu $?"
    if ! {
        echo "# $filename"
        echo "WERSJA=$WERSJA"
        echo "# "
        echo "# $timestamp"
        echo "# ${username}@${hostname}"
        if [[ -n "$HOST" && "$HOST" != "0.0.0.0" ]]; then
            echo "# ${HOST}:${PORT}"
        fi
        echo "# ---"
        echo "# "
        } > "$marker"; then
        echo_error $LINENO "Nie można zapisać nagłówka do pliku znacznika $marker"
    fi
    if [ -n "$lines_to_append" ]; then
        if ! echo "$lines_to_append" >> "$marker"; then
            echo_error $LINENO "Nie można dodać informacji do pliku znacznika $marker"
        fi
    fi
    if ! {
        echo "# ---"
        echo "# "
        } >> "$marker"; then
        echo_error $LINENO "Nie można zapisać stopki do pliku znacznika $marker"
    fi
    echo_info "Utworzono plik znacznika: $marker"
    return 0
}
collect_system_info() {
    local info=""
    info+="# ==========================================================\n"
    info+="# SYSTEM INFORMATION\n"
    info+="# ==========================================================\n"
    info+="# \n"
    local kernel_info
    kernel_info=$(uname -a 2>/dev/null) || kernel_info="Failed to get kernel info"
    info+="# Kernel Information:\n"
    info+="# ------------------\n"
    info+="# $kernel_info\n"
    info+="# \n"
    local debian_version
    debian_version=$(cat /etc/debian_version 2>/dev/null) || debian_version="unknown"
    info+="# OS Information:\n"
    info+="# --------------\n"
    info+="# Debian Version: $debian_version\n"
    info+="# LSB Release:\n"
    if command -v lsb_release >/dev/null 2>&1; then
        local lsb_info
        lsb_info=$(lsb_release -a 2>/dev/null | sed 's/^/# /') || lsb_info="# LSB Release information retrieval failed"
        info+="$lsb_info\n"
    else
        info+="# LSB Release information not available\n"
    fi
    info+="# \n"
    local hostname_info
    hostname_info=$(hostname 2>/dev/null) || hostname_info="unknown"
    local domain_name
    domain_name=$(hostname -d 2>/dev/null) || domain_name="N/A"
    local fqdn
    fqdn=$(hostname -f 2>/dev/null) || fqdn="N/A"
    local primary_ip
    primary_ip=$(hostname -I 2>/dev/null | awk '{print $1}') || primary_ip="unknown"
    local all_ips
    all_ips=$(hostname -I 2>/dev/null) || all_ips="unknown"
    info+="# Hostname & Network Information:\n"
    info+="# ------------------------------\n"
    info+="# Hostname: $hostname_info\n"
    info+="# Domain Name: $domain_name\n"
    info+="# Fully Qualified Domain Name: $fqdn\n"
    info+="# Primary IP: $primary_ip\n"
    info+="# All IPs: $all_ips\n"
    info+="# \n"
    info+="# Network Interfaces:\n"
    info+="# ------------------\n"
    if command -v ip >/dev/null 2>&1; then
        local interfaces
        interfaces=$(ip -br addr show 2>/dev/null) || interfaces="Failed to get interface information"
        while read -r line; do
            info+="# $line\n"
        done < <(echo "$interfaces")
    else
        info+="# ip command not available\n"
    fi
    info+="# \n"
    info+="# Routing Table:\n"
    info+="# -------------\n"
    if command -v ip >/dev/null 2>&1; then
        local routes
        routes=$(ip route 2>/dev/null) || routes="Failed to get routing information"
        local routes_commented="${routes//$'\n'/$'\n# '}"
        info+="# ${routes_commented}\n"
    else
        info+="# ip command not available\n"
    fi
    info+="# \n"
    info+="# DNS Settings:\n"
    info+="# ------------\n"
    if [ -f /etc/resolv.conf ]; then
        local dns_settings
        dns_settings=$(grep -v "^#" /etc/resolv.conf 2>/dev/null) || dns_settings="Failed to read DNS settings"
        local dns_commented="${dns_settings//$'\n'/$'\n# '}"
        info+="# ${dns_commented}\n"
    else
        info+="# resolv.conf not found\n"
    fi
    info+="# \n"
    info+="# Hardware Information:\n"
    info+="# -------------------\n"
    info+="# CPU:\n"
    if command -v lscpu >/dev/null 2>&1; then
        local cpu_info
        cpu_info=$(lscpu 2>/dev/null | grep "Model name\|Architecture\|CPU(s)\|CPU MHz") || cpu_info="Failed to get CPU info"
        local cpu_commented="${cpu_info//$'\n'/$'\n# '}"
        info+="# ${cpu_commented}\n"
    else
        info+="# lscpu command not available\n"
    fi
    info+="# \n"
    info+="# Memory Information:\n"
    info+="# -----------------\n"
    if command -v free >/dev/null 2>&1; then
        local memory_info
        memory_info=$(free -h 2>/dev/null) || memory_info="Failed to get memory info"
        local memory_commented="${memory_info//$'\n'/$'\n# '}"
        info+="# ${memory_commented}\n"
    else
        info+="# free command not available\n"
    fi
    info+="# \n"
    info+="# Storage Information:\n"
    info+="# ------------------\n"
    info+="# Root Filesystem:\n"
    if command -v df >/dev/null 2>&1; then
        local root_storage
        root_storage=$(df -h / 2>/dev/null) || root_storage="Failed to get root filesystem info"
        local root_storage_commented="${root_storage//$'\n'/$'\n# '}"
        info+="# ${root_storage_commented}\n"
        info+="# \n"
        info+="# All Mounted Filesystems:\n"
        local all_storage
        all_storage=$(df -h 2>/dev/null) || all_storage="Failed to get filesystem info"
        local all_storage_commented="${all_storage//$'\n'/$'\n# '}"
        info+="# ${all_storage_commented}\n"
    else
        info+="# df command not available\n"
    fi
    info+="# \n"
    info+="# Installed Packages Information:\n"
    info+="# -----------------------------\n"
    if command -v dpkg >/dev/null 2>&1; then
        local qt_version
        qt_version=$(dpkg -s libqt5core5a 2>/dev/null | grep '^Version:' | awk '{print $2}') || qt_version="not installed"
        info+="# Qt Version: $qt_version\n"
        for pkg in python3 gcc g++ make openssl libssl-dev openssh-server openssh-client; do
            local version
            version=$(dpkg -s $pkg 2>/dev/null | grep '^Version:' | awk '{print $2}') || version="not installed"
            info+="# $pkg: $version\n"
        done
    else
        info+="# dpkg command not available\n"
    fi
    info+="# \n"
    info+="# Service Status:\n"
    info+="# -------------\n"
    if command -v systemctl >/dev/null 2>&1; then
        for service in ssh dhcpcd networking cron systemd-timesyncd; do
            local status
            status=$(systemctl is-active $service 2>/dev/null) || status="inactive"
            info+="# $service: $status\n"
        done
    else
        info+="# systemctl command not available\n"
    fi
    info+="# \n"
    info+="# System Uptime:\n"
    info+="# ------------\n"
    if command -v uptime >/dev/null 2>&1; then
        local uptime_info
        uptime_info=$(uptime 2>/dev/null) || uptime_info="Failed to get uptime"
        info+="# $uptime_info\n"
    else
        info+="# uptime command not available\n"
    fi
    info+="# \n"
    info+="# Environment Variables:\n"
    info+="# --------------------\n"
    info+="# PATH: $PATH\n"
    info+="# USER: $USER\n"
    info+="# HOME: $HOME\n"
    info+="# SHELL: $SHELL\n"
    info+="# \n"
    info+="# Date and Time:\n"
    info+="# ------------\n"
    local current_time
    current_time=$(date 2>/dev/null) || current_time="Failed to get current time"
    info+="# Current Time: $current_time\n"
    local timezone
    if [ -f /etc/timezone ]; then
        timezone=$(cat /etc/timezone 2>/dev/null) || timezone="unknown"
    else
        timezone="unknown"
    fi
    info+="# Timezone: $timezone\n"
    info+="# \n"
    info+="# ==========================================================\n"
    echo "$info"
    return 0
}
# installer4lab embedded-scripts
# installer4lab generate_files()
main "$@"